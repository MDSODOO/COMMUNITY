[options]
addons_path = /usr/lib/python3/dist-packages/odoo/addons,/mnt/extra-addons
admin_passwd = CHANGE_ME
dbfilter = ^medicinedepot_dev$
proxy_mode = True
logfile = None
log_level = info

; --- Ajuste de rendimiento (servidor: 8 CPU / 15GB RAM) ---
workers = 5
max_cron_threads = 2
limit_memory_hard = 2684354560
limit_memory_soft = 2147483648
limit_time_cpu = 600
limit_time_real = 1200
db_maxconn = 32

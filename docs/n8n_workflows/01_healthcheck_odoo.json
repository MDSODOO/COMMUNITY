{
  "name": "01_Healthcheck_Odoo",
  "nodes": [
    {
      "id": "schedule-01",
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      }
    },
    {
      "id": "healthcheck-odoo",
      "name": "Healthcheck Odoo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "url": "https://odoo.bodegademedicamentos.com/web/health",
        "options": {
          "allowUnauthorizedCerts": true,
          "timeout": 8000
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput",
      "notes": "onError continueErrorOutput es clave: si Odoo esta totalmente caido (timeout/conexion rechazada), este nodo antes lanzaba una excepcion y el flujo se detenia ANTES de llegar al IF, por lo que nunca se enviaba la alerta. Ahora la falla de conexion se enruta explicitamente a la alerta."
    },
    {
      "id": "if-status-pass",
      "name": "IF - Status Pass?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        440,
        -80
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.status }}",
              "rightValue": "pass",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "preparar-alerta-degradado",
      "name": "Preparar Alerta - Estado Degradado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        -160
      ],
      "parameters": {
        "jsCode": "const body = $input.first().json;\nreturn [{ json: { text: `🟠 <b>Odoo responde pero con estado degradado</b>\\nStatus recibido: <code>${body.status ?? 'desconocido'}</code>` } }];"
      }
    },
    {
      "id": "preparar-alerta-sin-respuesta",
      "name": "Preparar Alerta - Sin Respuesta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        160
      ],
      "parameters": {
        "jsCode": "const err = $input.first().json;\nconst detalle = err.error?.message ?? err.message ?? JSON.stringify(err);\nreturn [{ json: { text: `🔴 <b>Odoo no esta respondiendo</b>\\nDetalle: <code>${detalle}</code>\\nReintentos agotados (2 intentos).` } }];"
      }
    },
    {
      "id": "enviar-alerta-telegram-01",
      "name": "Enviar Alerta Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $env.TELEGRAM_CHAT_ID, message_thread_id: 52, parse_mode: 'HTML', text: $json.text }) }}",
        "options": {
          "timeout": 10000
        }
      },
      "retryOnFail": true,
      "maxTries": 2
    }
  ],
  "connections": {
    "Schedule": {
      "main": [
        [
          {
            "node": "Healthcheck Odoo",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Healthcheck Odoo": {
      "main": [
        [
          {
            "node": "IF - Status Pass?",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Preparar Alerta - Sin Respuesta",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IF - Status Pass?": {
      "main": [
        [],
        [
          {
            "node": "Preparar Alerta - Estado Degradado",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Preparar Alerta - Estado Degradado": {
      "main": [
        [
          {
            "node": "Enviar Alerta Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Preparar Alerta - Sin Respuesta": {
      "main": [
        [
          {
            "node": "Enviar Alerta Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "error-handler-global-uuid"
  },
  "id": "healthcheck-odoo-uuid",
  "meta": {
    "instanceId": "medicinedepot"
  }
}
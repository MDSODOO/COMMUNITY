{
  "name": "07_Deteccion_Duplicados_Proveedores",
  "nodes": [
    {
      "id": "schedule-07",
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * 1"
            }
          ]
        }
      },
      "notes": "Semanal, lunes 8:00am."
    },
    {
      "id": "autenticar-odoo-07",
      "name": "Autenticar Odoo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ODOO_INTERNAL_URL }}/jsonrpc",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ jsonrpc: '2.0', method: 'call', params: { service: 'common', method: 'authenticate', args: [$env.ODOO_DB, $env.ODOO_USER, $env.ODOO_PASSWORD, {}] }, id: 1 }) }}",
        "options": {
          "timeout": 10000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "onError": "continueErrorOutput"
    },
    {
      "id": "if-auth-ok-07",
      "name": "IF - Auth OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        440,
        -80
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.error }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "empty"
              }
            },
            {
              "leftValue": "={{ typeof $json.result }}",
              "rightValue": "number",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "buscar-partners-vat-07",
      "name": "Buscar Partners Con VAT",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        -160
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ODOO_INTERNAL_URL }}/jsonrpc",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ jsonrpc: '2.0', method: 'call', params: { service: 'object', method: 'execute_kw', args: [$env.ODOO_DB, $json.result, $env.ODOO_PASSWORD, 'res.partner', 'search_read', [[['vat', '!=', false], ['active', '=', true]]], { fields: ['id', 'name', 'vat', 'supplier_rank', 'customer_rank'], limit: 5000, order: 'vat, supplier_rank desc' }] }, id: 1 }) }}",
        "options": {
          "timeout": 20000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "onError": "continueErrorOutput",
      "notes": "limit=5000 con headroom sobre el total de res.partner activos (~3498 al momento de la auditoria 2026-08-12). Si la base crece mucho mas, subir el limite o migrar a read_group paginado."
    },
    {
      "id": "agrupar-detectar-duplicados-07",
      "name": "Agrupar Por VAT Y Detectar Duplicados",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        -160
      ],
      "notes": "Filtro vat.length<5 agregado tras validacion manual 2026-08-12: sin el, el valor placeholder '.' agrupaba entidades no relacionadas (falso positivo detectado antes de activar en produccion).",
      "parameters": {
        "jsCode": "const rows = $input.first().json.result || [];\nconst groups = {};\nfor (const r of rows) {\n  const vat = (r.vat || '').trim().toUpperCase();\n  if (!vat || vat.length < 5) continue;\n  if (!groups[vat]) groups[vat] = [];\n  groups[vat].push(r);\n}\nconst duplicates = Object.entries(groups)\n  .filter(([vat, items]) => items.length > 1)\n  .map(([vat, items]) => ({ vat, items }));\nreturn [{ json: { duplicates, duplicate_count: duplicates.length, total_revisados: rows.length } }];"
      }
    },
    {
      "id": "if-hay-duplicados-07",
      "name": "IF - Hay Duplicados?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1100,
        -160
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.duplicate_count }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "formatear-resumen-duplicados-07",
      "name": "Formatear Resumen Duplicados",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        -240
      ],
      "parameters": {
        "jsCode": "const dup = $input.first().json.duplicates || [];\nconst top = dup.slice(0, 15);\nconst lineas = top.map(d => {\n  const nombres = d.items.map(i => `${i.name} (id ${i.id}, supplier_rank=${i.supplier_rank}, customer_rank=${i.customer_rank})`).join(' | ');\n  return `• VAT ${d.vat}: ${nombres}`;\n});\nlet text = `⚠️ <b>Posibles proveedores/clientes duplicados</b>\\n<b>${dup.length}</b> RFC/VAT con más de un registro activo (de ${$input.first().json.total_revisados ?? '?'} revisados):\\n` + lineas.join('\\n');\nif (dup.length > 15) { text += `\\n… y ${dup.length - 15} más (ver Odoo para detalle completo)`; }\ntext += `\\n\\n<i>Revisar manualmente antes de fusionar. Usar el wizard de merge de Odoo (base.partner.merge.automatic.wizard) tras confirmar referencias transaccionales reales por modelo. Nunca eliminar directamente.</i>`;\nreturn [{ json: { text } }];"
      }
    },
    {
      "id": "formatear-heartbeat-duplicados-07",
      "name": "Formatear Heartbeat Sin Duplicados",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        -80
      ],
      "parameters": {
        "jsCode": "return [{ json: { text: '✅ Deteccion de Duplicados de Proveedores/Clientes: sin duplicados por VAT esta semana.' } }];"
      }
    },
    {
      "id": "preparar-alerta-fallo-auth-07",
      "name": "Preparar Alerta - Fallo Autenticacion",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        160
      ],
      "parameters": {
        "jsCode": "const err = $input.first().json;\nconst detalle = err.error?.message ?? err.message ?? JSON.stringify(err);\nreturn [{ json: { text: `🔴 <b>Deteccion Duplicados Proveedores: fallo al autenticar contra Odoo</b>\\nDetalle: <code>${detalle}</code>` } }];"
      }
    },
    {
      "id": "preparar-alerta-fallo-query-07",
      "name": "Preparar Alerta - Fallo Consulta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        160
      ],
      "parameters": {
        "jsCode": "const err = $input.first().json;\nconst detalle = err.error?.message ?? err.message ?? JSON.stringify(err);\nreturn [{ json: { text: `🔴 <b>Deteccion Duplicados Proveedores: fallo al consultar res.partner</b>\\nDetalle: <code>${detalle}</code>` } }];"
      }
    },
    {
      "id": "notificar-telegram-duplicados-07",
      "name": "Notificar Telegram Duplicados",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $env.TELEGRAM_CHAT_ID, message_thread_id: 6, parse_mode: 'HTML', text: $json.text }) }}",
        "options": {
          "timeout": 10000
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "notes": "message_thread_id=6 = topic Compras (no existe topic dedicado a calidad de datos de proveedores; Compras es el mas cercano tematicamente, mismo criterio usado en 04)."
    }
  ],

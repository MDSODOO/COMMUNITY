{
  "name": "10_Backlog_Pickings_Atascados",
  "nodes": [
    {
      "id": "schedule-10",
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "30 8 * * 1"
            }
          ]
        }
      },
      "notes": "Semanal, lunes 8:30am. Subir frecuencia (ej. cada 6h) una vez que el backlog historico de la migracion se limpie y el flujo refleje operacion real del dia a dia."
    },
    {
      "id": "autenticar-odoo-10",
      "name": "Autenticar Odoo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ODOO_INTERNAL_URL }}/jsonrpc",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ jsonrpc: '2.0', method: 'call', params: { service: 'common', method: 'authenticate', args: [$env.ODOO_DB, $env.ODOO_USER, $env.ODOO_PASSWORD, {}] }, id: 1 }) }}",
        "options": {
          "timeout": 10000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "onError": "continueErrorOutput"
    },
    {
      "id": "if-auth-ok-10",
      "name": "IF - Auth OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        440,
        -80
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.error }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "empty"
              }
            },
            {
              "leftValue": "={{ typeof $json.result }}",
              "rightValue": "number",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "resumen-por-tipo-10",
      "name": "Resumen Por Tipo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        -160
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ODOO_INTERNAL_URL }}/jsonrpc",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ jsonrpc: '2.0', method: 'call', params: { service: 'object', method: 'execute_kw', args: [$env.ODOO_DB, $json.result, $env.ODOO_PASSWORD, 'stock.picking', 'read_group', [[['state','=','assigned']], ['id:count'], ['picking_type_id']]] }, id: 1 }) }}",
        "options": {
          "timeout": 20000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "onError": "continueErrorOutput"
    },
    {
      "id": "pickings-mas-antiguos-10",
      "name": "Pickings Mas Antiguos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        -160
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.ODOO_INTERNAL_URL }}/jsonrpc",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ jsonrpc: '2.0', method: 'call', params: { service: 'object', method: 'execute_kw', args: [$env.ODOO_DB, $('Autenticar Odoo').item.json.result, $env.ODOO_PASSWORD, 'stock.picking', 'search_read', [[['state','=','assigned']]], { fields: ['id','name','picking_type_id','partner_id','origin','create_date'], limit: 10, order: 'create_date asc' }] }, id: 1 }) }}",
        "options": {
          "timeout": 20000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "onError": "continueErrorOutput"
    },
    {
      "id": "if-hay-backlog-10",
      "name": "IF - Hay Backlog?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1100,
        -160
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ ($json.result || []).length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "formatear-resumen-pickings-10",
      "name": "Formatear Resumen Pickings",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        -240
      ],
      "parameters": {
        "jsCode": "const oldest = $json.result || [];\nconst grupos = $('Resumen Por Tipo').first().json.result || [];\nconst totalCount = grupos.reduce((s, g) => s + (g.picking_type_id_count || g.__count || 0), 0);\n\nlet text = `🧳 <b>Backlog de Recepciones/Entregas Pendientes</b>\\n<b>${totalCount}</b> movimiento(s) reservado(s) sin completar (estado 'assigned').\\n\\n`;\ntext += `<b>Por tipo:</b>\\n`;\nfor (const g of grupos) {\n  const cnt = g.picking_type_id_count || g.__count || 0;\n  const nombre = g.picking_type_id ? g.picking_type_id[1] : 'Sin tipo';\n  text += `• ${nombre}: ${cnt}\\n`;\n}\ntext += `\\n<b>Los 10 mas antiguos:</b>\\n`;\nfor (const p of oldest) {\n  const dias = Math.floor((Date.now() - new Date(p.create_date + 'Z')) / 86400000);\n  text += `• ${p.name} — ${p.partner_id?.[1] ?? 'N/D'} (origen ${p.origin ?? 'N/D'}) — ${dias}d\\n`;\n}\ntext += `\\n<i>Revisar en Odoo: completar la recepcion/entrega o liberar la reserva si ya no aplica. Nota: la mayoria de este backlog viene de la migracion de julio 2026.</i>`;\n\nreturn [{ json: { text } }];"
      }
    },
    {
      "id": "formatear-heartbeat-pickings-10",
      "name": "Formatear Heartbeat Sin Backlog",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        -80
      ],
      "parameters": {
        "jsCode": "return [{ json: { text: '✅ Backlog de Recepciones/Entregas: sin movimientos atascados.' } }];"
      }
    },
    {
      "id": "preparar-alerta-fallo-auth-10",
      "name": "Preparar Alerta - Fallo Autenticacion",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        160
      ],
      "parameters": {
        "jsCode": "const err = $input.first().json;\nconst detalle = err.error?.message ?? err.message ?? JSON.stringify(err);\nreturn [{ json: { text: `🔴 <b>Backlog Pickings: fallo al autenticar contra Odoo</b>\\nDetalle: <code>${detalle}</code>` } }];"
      }
    },
    {
      "id": "preparar-alerta-fallo-consulta-10",
      "name": "Preparar Alerta - Fallo Consulta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        160
      ],
      "parameters": {
        "jsCode": "const err = $input.first().json;\nconst detalle = err.error?.message ?? err.message ?? JSON.stringify(err);\nreturn [{ json: { text: `🔴 <b>Backlog Pickings: fallo al consultar stock.picking</b>\\nDetalle: <code>${detalle}</code>` } }];"
      }
    },
    {
      "id": "notificar-telegram-pickings-10",
      "name": "Notificar Telegram Pickings",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $env.TELEGRAM_CHAT_ID, message_thread_id: 8, parse_mode: 'HTML', text: $json.text }) }}",
        "options": {
          "timeout": 10000
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "notes": "message_thread_id=8 = topic Recepcion y Almacen."
    }
  ],

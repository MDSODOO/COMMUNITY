<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ── Columnas de lote / caducidad en la tabla de líneas de OC ─────────── -->
    <record id="view_purchase_order_form_lot" model="ir.ui.view">
        <field name="name">purchase.order.form.lot</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='order_line']/list/field[@name='product_qty']" position="after">
                <!--
                    Selección / Creación de Lote.
                    no_quick_create: True  →  deshabilita el "Create 'xxx'" inline
                    del dropdown. Obliga al usuario a usar "Crear y editar..." que
                    abre el modal completo de stock.lot donde expiration_date es
                    visible y editable. Esto evita que el lote se cree con la
                    fecha default del producto (posiblemente pasada) sin que el
                    usuario la revise.
                -->
                <field name="lot_id"
                       invisible="product_id.tracking == 'none'"
                       column_invisible="parent.state == 'purchase'"
                       readonly="0"
                       context="{
                           'default_product_id': product_id,
                           'default_company_id': company_id
                       }"
                       options="{'no_create': False, 'no_quick_create': True, 'no_open': False}"
                />

                <!--
                    Fecha de Caducidad — EDITABLE en estado borrador/enviado.
                    Requerida cuando hay lote seleccionado: fuerza al usuario a
                    ingresar una fecha válida antes de guardar/confirmar.
                -->
                <field name="lot_expiration_date"
                       string="Caduca"
                       invisible="not lot_id"
                       column_invisible="parent.state == 'purchase'"
                       readonly="parent.state not in ('draft', 'sent')"
                       required="bool(lot_id)"
                />

                <!-- Lotes recibidos en el albarán (sólo visible post-confirmación) -->
                <field name="picking_lot_ids"
                       widget="many2many_tags"
                       column_invisible="parent.state != 'purchase'"
                       readonly="1"
                />

            </xpath>

        </field>
    </record>

    <!-- ── Ocultar columna Distribución Analítica en la tabla de líneas ──────── -->
    <record id="view_purchase_order_form_hide_analytic" model="ir.ui.view">
        <field name="name">purchase.order.form.hide.analytic</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='order_line']/list/field[@name='analytic_distribution']"
                   position="attributes">
                <attribute name="column_invisible">True</attribute>
            </xpath>

        </field>
    </record>
</odoo>

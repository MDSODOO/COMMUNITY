<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cada minuto: es el latido de la cola. Con Telegram sano el mensaje
             sale en <60s; si está caído, el backoff de la propia cola espacia
             los reintentos, no este intervalo. -->
        <record id="cron_md_telegram_dispatch" model="ir.cron">
            <field name="name">Telegram: enviar cola de mensajes</field>
            <field name="model_id" ref="model_md_telegram_message"/>
            <field name="state">code</field>
            <field name="code">model._cron_dispatch()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>

        <!-- Limpieza: la cola es un log operativo, no un archivo histórico. -->
        <record id="cron_md_telegram_gc" model="ir.cron">
            <field name="name">Telegram: purgar mensajes antiguos</field>
            <field name="model_id" ref="model_md_telegram_message"/>
            <field name="state">code</field>
            <field name="code">model._cron_gc()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>

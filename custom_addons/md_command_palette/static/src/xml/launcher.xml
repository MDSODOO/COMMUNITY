<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="md_command_palette.Launcher">
        <div t-if="state.open" class="o_md_command_palette_backdrop" t-on-click="close">
            <div class="o_md_command_palette"
                 role="dialog"
                 aria-modal="true"
                 aria-label="Buscador y navegación / Search and navigation"
                 t-on-click.stop="">
                <div class="o_md_command_palette_input_wrap">
                    <i class="fa fa-search o_md_command_palette_icon"/>
                    <input t-ref="paletteInput"
                           type="text"
                           role="combobox"
                           aria-expanded="true"
                           aria-autocomplete="list"
                           aria-controls="o_md_launcher_results"
                           t-attf-aria-activedescendant="{{ results[state.activeIndex] ? results[state.activeIndex].key : '' }}"
                           class="o_md_command_palette_input"
                           placeholder="Buscar menús, productos… / Search menus, products…"
                           t-on-input="onInput"/>
                    <span class="o_md_command_palette_hint">Esc</span>
                </div>
                <div id="o_md_launcher_results" class="o_md_command_palette_results" role="listbox">

                    <!-- ══ Estado por defecto (sin búsqueda activa): grid de -->
                    <!-- "Acciones Sugeridas / Acciones Rápidas" ══ -->
                    <div t-if="!state.query.trim()"
                         class="o_md_command_palette_group o_md_command_palette_group--suggested"
                         role="group"
                         aria-label="Acciones Rápidas y Aplicaciones">
                        <div class="o_md_command_palette_group_label">
                            <i class="oi oi-bolt me-1" aria-hidden="true"/>
                            <span>Acciones Sugeridas / Suggested Actions</span>
                            <span class="o_md_command_palette_group_count" t-esc="state.suggestedApps.length"/>
                        </div>
                        <div t-if="state.suggestedApps.length"
                             class="o_md_launcher_suggested_grid"
                             role="listbox"
                             aria-orientation="horizontal">
                            <t t-foreach="results" t-as="item" t-key="item.key">
                                <div t-att-id="item.key"
                                     role="option"
                                     tabindex="0"
                                     t-att-title="item.label"
                                     t-att-aria-label="item.label"
                                     t-attf-aria-selected="{{ results.indexOf(item) === state.activeIndex ? 'true' : 'false' }}"
                                     t-attf-class="o_md_launcher_app_tile {{ results.indexOf(item) === state.activeIndex ? 'active' : '' }}"
                                     t-on-click="() => this.onItemClick(item)"
                                     t-on-mouseenter="() => this.state.activeIndex = results.indexOf(item)">
                                    <span class="o_md_launcher_app_icon">
                                        <img t-att-src="item.iconUrl" t-att-alt="item.label" loading="lazy"/>
                                    </span>
                                    <span class="o_md_launcher_app_label uppercase" t-esc="item.label"/>
                                    <span t-if="item_index &lt; 9" class="o_md_launcher_quick_badge" aria-hidden="true">
                                        <kbd>Alt+<t t-esc="item_index + 1"/></kbd>
                                    </span>
                                </div>
                            </t>
                        </div>
                        <div t-else="" class="o_md_command_palette_empty">
                            <i class="fa fa-th-large o_md_command_palette_empty_icon"/>
                            <span>Escribe para buscar / Start typing to search</span>
                        </div>
                    </div>

                    <!-- ══ Estado de búsqueda activa: resultados agrupados ══ -->
                    <t t-else="">
                        <div t-if="!results.length" class="o_md_command_palette_empty">
                            <i class="fa fa-search-minus o_md_command_palette_empty_icon"/>
                            <span>
                                Sin resultados para “<t t-esc="state.query"/>” / No results for “<t t-esc="state.query"/>”
                            </span>
                        </div>
                        <div t-if="state.quickActionResults.length" class="o_md_command_palette_group o_md_command_palette_group--quickaction">
                            <div class="o_md_command_palette_group_label">
                                <i class="oi oi-bolt me-1" aria-hidden="true"/>
                                Acciones rápidas / Quick actions <span class="o_md_command_palette_group_count" t-esc="state.quickActionResults.length"/>
                            </div>
                            <t t-foreach="state.quickActionResults" t-as="item" t-key="item.key">
                                <div t-att-id="item.key"
                                     role="option"
                                     tabindex="0"
                                     t-att-title="item.label"
                                     t-att-aria-label="item.label"
                                     t-attf-aria-selected="{{ results.indexOf(item) === state.activeIndex ? 'true' : 'false' }}"
                                     t-attf-class="o_md_command_palette_item {{ results.indexOf(item) === state.activeIndex ? 'active' : '' }}"
                                     t-on-click="() => this.onItemClick(item)"
                                     t-on-mouseenter="() => this.state.activeIndex = results.indexOf(item)">
                                    <span class="o_md_command_palette_avatar o_md_command_palette_avatar--action">
                                        <i t-attf-class="fa {{ item.icon.startsWith('fa-') ? item.icon : 'fa-' + item.icon }}" aria-hidden="true"/>
                                    </span>
                                    <span t-esc="item.label"/>
                                    <span class="o_md_command_palette_chip o_md_command_palette_chip--action">
                                        Acción Rápida
                                    </span>
                                </div>
                            </t>
                        </div>
                        <div t-if="state.customReportResults.length" class="o_md_command_palette_group o_md_command_palette_group--customreport">
                            <div class="o_md_command_palette_group_label">
                                <i class="fa fa-file-text-o me-1" aria-hidden="true"/>
                                Reportes Personalizados / Custom Reports <span class="o_md_command_palette_group_count" t-esc="state.customReportResults.length"/>
                            </div>
                            <t t-foreach="state.customReportResults" t-as="item" t-key="item.key">
                                <div t-att-id="item.key"
                                     role="option"
                                     tabindex="0"
                                     t-att-title="item.label"
                                     t-att-aria-label="item.label"
                                     t-attf-aria-selected="{{ results.indexOf(item) === state.activeIndex ? 'true' : 'false' }}"
                                     t-attf-class="o_md_command_palette_item {{ results.indexOf(item) === state.activeIndex ? 'active' : '' }}"
                                     t-on-click="() => this.onItemClick(item)"
                                     t-on-mouseenter="() => this.state.activeIndex = results.indexOf(item)">
                                    <span class="o_md_command_palette_avatar o_md_command_palette_avatar--report">
                                        <i t-attf-class="fa {{ item.icon.startsWith('fa-') ? item.icon : 'fa-' + item.icon }}" aria-hidden="true"/>
                                    </span>
                                    <span t-esc="item.label"/>
                                    <span t-attf-class="o_md_command_palette_chip o_md_command_palette_chip--{{ item.reportType }}">
                                        <t t-esc="item.reportType === 'excel' ? 'Excel XLSX' : 'PDF'"/>
                                    </span>
                                </div>
                            </t>
                        </div>
                        <div t-if="state.menuResults.length" class="o_md_command_palette_group o_md_command_palette_group--menu">
                            <div class="o_md_command_palette_group_label">
                                Menús / Menus <span class="o_md_command_palette_group_count" t-esc="state.menuResults.length"/>
                            </div>
                            <t t-foreach="state.menuResults" t-as="item" t-key="item.key">
                                <div t-att-id="item.key"
                                     role="option"
                                     t-attf-aria-selected="{{ results.indexOf(item) === state.activeIndex ? 'true' : 'false' }}"
                                     t-attf-class="o_md_command_palette_item {{ results.indexOf(item) === state.activeIndex ? 'active' : '' }}"
                                     t-on-click="() => this.onItemClick(item)"
                                     t-on-mouseenter="() => this.state.activeIndex = results.indexOf(item)">
                                    <span class="o_md_command_palette_avatar">
                                        <!-- Prioridad: imagen del módulo > ícono FA > fallback genérico -->
                                        <img t-if="item.iconUrl" t-att-src="item.iconUrl" alt="" aria-hidden="true"/>
                                        <i t-elif="item.faIcon"
                                           t-attf-class="fa {{ item.faIcon }}"
                                           aria-hidden="true"/>
                                        <i t-else="" class="fa fa-th-large" aria-hidden="true"/>
                                    </span>
                                    <span t-esc="item.label"/>
                                </div>
                            </t>
                        </div>
                        <div t-if="state.productResults.length" class="o_md_command_palette_group o_md_command_palette_group--product">
                            <div class="o_md_command_palette_group_label">
                                Productos / Products <span class="o_md_command_palette_group_count" t-esc="state.productResults.length"/>
                            </div>
                            <t t-foreach="state.productResults" t-as="item" t-key="item.key">
                                <div t-att-id="item.key"
                                     role="option"
                                     t-attf-aria-selected="{{ results.indexOf(item) === state.activeIndex ? 'true' : 'false' }}"
                                     t-attf-class="o_md_command_palette_item {{ results.indexOf(item) === state.activeIndex ? 'active' : '' }}"
                                     t-on-click="() => this.onItemClick(item)"
                                     t-on-mouseenter="() => this.state.activeIndex = results.indexOf(item)">
                                    <span class="o_md_command_palette_avatar o_md_command_palette_avatar--product">
                                        <img t-att-src="item.imageUrl" alt=""/>
                                    </span>
                                    <span t-esc="item.label"/>
                                    <span class="o_md_command_palette_chip">
                                        <t t-esc="item.onHand"/> <t t-esc="item.uom"/> A la mano
                                    </span>
                                    <span t-if="productRowActions.length" class="o_md_command_palette_product_actions">
                                        <t t-foreach="productRowActions" t-as="paction" t-key="paction.id">
                                            <button t-if="!paction.visible || paction.visible(item.record)"
                                                    type="button"
                                                    t-attf-class="o_md_command_palette_product_action_btn {{ paction.colorClass ? 'o_md_command_palette_product_action_btn--' + paction.colorClass : '' }}"
                                                    t-att-title="paction.title"
                                                    t-att-aria-label="paction.title"
                                                    t-on-click="(ev) => this.onProductRowAction(ev, paction, item.record)">
                                                <i t-attf-class="fa {{ paction.icon }}" aria-hidden="true"/>
                                            </button>
                                        </t>
                                    </span>
                                </div>
                            </t>
                        </div>
                    </t>

                </div>
                <div class="o_md_command_palette_footer">
                    <span><kbd>↑</kbd><kbd>↓</kbd> navegar / navigate</span>
                    <span><kbd>Enter</kbd> abrir / open</span>
                    <span><kbd>Ctrl</kbd>+<kbd>K</kbd> / <kbd>Alt</kbd>+<kbd>Espacio</kbd></span>
                </div>
            </div>
        </div>
    </t>
</templates>

<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="res_config_settings_inv_global_form" model="ir.ui.view">
        <field name="name">res.config.settings.inv.global.form</field>
        <field name="model">res.config.settings</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//block[@id='invoicing_settings']" position="inside">

                <setting string="Contacto Factura global">
                    <field name="partner_inv_global_id" options="{'no_create':True}"/>
                </setting>

                <setting string="Diario Factura global">
                    <field name="journal_inv_global_id" options="{'no_create':True}"/>
                </setting>

            </xpath>

        </field>
    </record>

    <record id="res_config_settings_pos_global_form" model="ir.ui.view">
        <field name="name">res.config.settings.pos.global.form</field>
        <field name="model">res.config.settings</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_inventory_section']" position="after">
                <block title="Facturación Global" id="global_invoice">
                    <setting string="Facturacion global activa desde cierre POS">
                        <field name="pos_active_facturacion_global"/>
                    </setting>
                    <setting string="Cliente Factura Global (POS)">
                        <field name="pos_partner_global_id" options="{'no_create':True}"/>
                    </setting>
                    <setting string="Diario Factura Global (POS)">
                        <field name="pos_journal_global_id" options="{'no_create':True}"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>


</odoo>

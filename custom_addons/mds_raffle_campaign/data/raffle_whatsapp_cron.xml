<odoo>
    <record id="ir_cron_raffle_whatsapp_notify" model="ir.cron">
        <field name="name">Rifa: Notificar actualización de boletos por WhatsApp</field>
        <field name="model_id" ref="model_raffle_campaign"/>
        <field name="state">code</field>
        <field name="code">model._cron_notify_whatsapp_ticket_updates()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <!-- Inactivo por defecto: no hay credenciales reales de Meta Cloud
             API todavía. Activar en Ajustes > Técnico > Acciones Automáticas
             una vez configurado el token en Ajustes > Rifas. -->
        <field name="active" eval="False"/>
    </record>
</odoo>

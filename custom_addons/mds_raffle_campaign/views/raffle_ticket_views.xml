<odoo>
    <record id="view_raffle_ticket_list" model="ir.ui.view">
        <field name="name">raffle.ticket.list</field>
        <field name="model">raffle.ticket</field>
        <field name="arch" type="xml">
            <list string="Folios de Rifa" default_order="id desc">
                <field name="name"/>
                <field name="campaign_id"/>
                <field name="partner_id"/>
                <field name="origin_type"/>
                <field name="rule_id"/>
                <field name="calc_tickets_awarded" string="Boletos otorgados (evento)"/>
                <field name="sale_order_id"/>
                <field name="pos_order_id"/>
                <field name="legacy_ref" optional="hide"/>
                <field name="state" decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_raffle_ticket_form" model="ir.ui.view">
        <field name="name">raffle.ticket.form</field>
        <field name="model">raffle.ticket</field>
        <field name="arch" type="xml">
            <form string="Folio de Rifa">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="campaign_id"/>
                        <field name="partner_id"/>
                        <field name="origin_type"/>
                        <field name="rule_id"/>
                        <field name="sale_order_id"/>
                        <field name="pos_order_id"/>
                        <field name="legacy_ref"/>
                        <field name="state"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                    <notebook>
                        <page string="Desglose de Cálculo" name="calc_breakdown">
                            <div class="d-flex align-items-center gap-2 mb-3">
                                <field name="calc_confidence" widget="badge"
                                       decoration-success="calc_confidence == 'exact'"
                                       decoration-warning="calc_confidence == 'estimated'"
                                       nolabel="1"/>
                            </div>
                            <div class="alert alert-warning mb-3" role="alert"
                                 invisible="calc_confidence != 'estimated'">
                                <strong>Monto estimado.</strong> Este folio es anterior a esta
                                auditoría de trazabilidad y no se localizó su documento de venta
                                de origen: el monto acumulado del periodo es el MÍNIMO que
                                explica la cantidad de boletos otorgados (umbral × boletos),
                                no necesariamente el monto real de venta de ese día.
                            </div>
                            <div class="alert alert-success mb-3" role="alert"
                                 invisible="calc_confidence != 'exact'">
                                <strong>Monto exacto.</strong> Calculado al momento de emitir el
                                folio, tomado de un pedido de venta vinculado, o reconstruido
                                desde el documento de origen importado del Excel histórico.
                            </div>
                            <group>
                                <group string="Regla aplicada">
                                    <field name="rule_type"/>
                                    <field name="ticket_date"/>
                                    <field name="rule_tickets_awarded"/>
                                </group>
                                <group string="Memoria de cálculo">
                                    <field name="calc_base_amount"/>
                                    <field name="calc_period_amount"/>
                                    <field name="calc_tickets_awarded"/>
                                </group>
                            </group>
                            <group string="Cómo se llegó a este resultado">
                                <field name="calc_detail" nolabel="1" readonly="1" class="text-muted"/>
                            </group>
                        </page>
                        <page string="Documentos de Venta Relacionados" name="related_documents">
                            <group>
                                <field name="calc_source_refs"/>
                            </group>
                            <group string="Documentos de origen (Excel histórico)"
                                   invisible="not source_document_ids">
                                <field name="source_document_ids" nolabel="1" readonly="1">
                                    <list decoration-muted="is_billed_duplicate">
                                        <field name="folio"/>
                                        <field name="source_file"/>
                                        <field name="doc_date"/>
                                        <field name="partner_name"/>
                                        <field name="amount_total"/>
                                        <field name="line_count"/>
                                        <field name="linked_document_id"/>
                                        <field name="is_billed_duplicate" optional="hide"/>
                                    </list>
                                </field>
                            </group>
                            <group string="Pedidos de venta (B2B online) del día"
                                   invisible="not related_sale_order_ids">
                                <field name="related_sale_order_ids" nolabel="1" readonly="1">
                                    <list>
                                        <field name="name"/>
                                        <field name="date_order"/>
                                        <field name="amount_total"/>
                                        <field name="state"/>
                                    </list>
                                </field>
                            </group>
                            <group string="Pedidos POS (físico) del día"
                                   invisible="not related_pos_order_ids">
                                <field name="related_pos_order_ids" nolabel="1" readonly="1">
                                    <list>
                                        <field name="name"/>
                                        <field name="date_order"/>
                                        <field name="amount_total"/>
                                        <field name="state"/>
                                    </list>
                                </field>
                            </group>
                            <div class="alert alert-info" role="alert"
                                 invisible="source_document_ids or related_sale_order_ids or related_pos_order_ids">
                                No se encontró ningún documento de venta (pedido real en Odoo ni
                                documento importado del Excel histórico) para este folio. Ver
                                "Documentos que integran el cálculo" arriba para la referencia
                                de origen en texto.
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_raffle_ticket_search" model="ir.ui.view">
        <field name="name">raffle.ticket.search</field>
        <field name="model">raffle.ticket</field>
        <field name="arch" type="xml">
            <search string="Buscar Folios">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="campaign_id"/>
                <field name="legacy_ref"/>
                <filter string="Válidos" name="valid" domain="[('state', '=', 'valid')]"/>
                <filter string="Físicos" name="physical" domain="[('origin_type', '=', 'physical')]"/>
                <filter string="B2B Online" name="online" domain="[('origin_type', '=', 'online_b2b')]"/>
                <group>
                    <filter string="Campaña" name="group_campaign" context="{'group_by': 'campaign_id'}"/>
                    <filter string="Origen" name="group_origin" context="{'group_by': 'origin_type'}"/>
                    <filter string="Cliente" name="group_partner" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_raffle_ticket" model="ir.actions.act_window">
        <field name="name">Folios de Rifa</field>
        <field name="res_model">raffle.ticket</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_raffle_ticket_search"/>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
      Paperformat personalizado para los reportes de Bajas (individual + consolidado).

      CAUSA RAÍZ del espacio en blanco superior:
      El paperformat default de Odoo tiene header_spacing > 0, que con
      web.external_layout reserva una franja superior para el header de
      wkhtmltopdf. Como pharma_full_header vive en el body del documento
      (no en web.external_layout_*), esa franja queda visualmente vacía
      — se ve como un hueco arriba del logo en el PDF.

      Mismo patrón aplicado en pharma_reports (sale_order_paperformat.xml,
      purchase_order_paperformat.xml, stock_transfer_report.xml):
        · header_spacing = 0   → elimina la franja reservada
        · header_line   = False → sin línea separadora
        · margin_top    = 15   → margen superior coherente con otros reportes pharma
        · margin_bottom = 10
        · dpi           = 90
    -->
    <record id="paperformat_scrap_batch_pharma" model="report.paperformat">
        <field name="name">Bajas — Medicine Depot (Orden + Consolidado)</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="page_height" eval="False"/>
        <field name="page_width" eval="False"/>
        <field name="orientation">Portrait</field>
        <field name="margin_top">15</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <!-- Asignar a Orden de bajas individual -->
    <record id="action_report_stock_scrap_batch" model="ir.actions.report">
        <field name="paperformat_id" ref="paperformat_scrap_batch_pharma"/>
    </record>

    <!-- Asignar a Consolidado de Bajas -->
    <record id="action_report_scrap_batch_consolidated" model="ir.actions.report">
        <field name="paperformat_id" ref="paperformat_scrap_batch_pharma"/>
    </record>

</odoo>

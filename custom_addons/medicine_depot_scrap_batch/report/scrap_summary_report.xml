<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_scrap_summary_2025" model="ir.actions.report">
        <field name="name">Acumulado del mes - PDF</field>
        <field name="model">medicine.depot.scrap.summary.2025</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">medicine_depot_scrap_batch.report_scrap_summary</field>
        <field name="report_file">medicine_depot_scrap_batch.report_scrap_summary</field>
        <field name="binding_model_id" ref="model_medicine_depot_scrap_summary_2025"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Acumulado del mes'</field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════════
         HEADER PHARMA PARA EL NIVEL DE LAYOUT

         Inyecta el header estándar pharma dentro del div.header del layout
         para mantener coherencia visual con otros reportes.
    ════════════════════════════════════════════════════════════════════════ -->
    <template id="pharma_scrap_summary_layout_header">
        <t t-set="_sb" t-value="o if o else doc"/>
        <t t-if="_sb and _sb._name == 'medicine.depot.scrap.summary.2025'">
            <t t-set="_sb_co" t-value="_sb.company_id.sudo()"/>
            <div class="pharma-full-header">
                <div class="d-flex align-items-start justify-content-between pharma-doc-header">
                    <div class="pharma-logo-shell">
                        <img t-if="_sb_co.logo" class="md-logo"
                             t-att-src="image_data_uri(_sb_co.logo)" alt="Logo"/>
                        <div t-if="_sb_co.report_header"
                             t-field="_sb_co.report_header"
                             class="o_company_tagline fw-bold mt-1"/>
                    </div>
                    <div class="pharma-doc-info text-end">
                        <span class="pharma-doc-type">Reporte de Bajas</span>
                        <span class="pharma-doc-date">
                            <span t-esc="datetime.datetime.now().strftime('%Y-%m-%d')"/>
                        </span>
                    </div>
                </div>
                <div class="pharma-stripe">
                    <span class="pharma-stripe-band pharma-stripe-band-brand"/>
                    <span class="pharma-stripe-band pharma-stripe-band-teal"/>
                    <span class="pharma-stripe-band pharma-stripe-band-lime"/>
                </div>
                <div class="row g-0 pharma-meta-band">
                    <div class="col-3 pharma-meta-cell">
                        <span class="pharma-meta-label">Período</span>
                        <span class="pharma-meta-val" t-esc="_sb.periodo and _sb.periodo.strftime('%B %Y') or '—'"/>
                    </div>
                    <div class="col-3 pharma-meta-cell">
                        <span class="pharma-meta-label">Sucursal</span>
                        <span class="pharma-meta-val" t-esc="_sb.sucursal or '—'"/>
                    </div>
                    <div class="col-3 pharma-meta-cell">
                        <span class="pharma-meta-label">Mes</span>
                        <span class="pharma-meta-val" t-esc="dict(_sb._fields['mes'].selection).get(_sb.mes) or '—'"/>
                    </div>
                    <div class="col-3 pharma-meta-cell">
                        <span class="pharma-meta-label">Compañía</span>
                        <span class="pharma-meta-val" t-esc="_sb_co.name or '—'"/>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- ═══════════════════════════════════════════════════════════════════
         OVERRIDES DE LAYOUT — prioridad 1001
    ════════════════════════════════════════════════════════════════════════ -->

    <!-- Layout STANDARD ─────────────────────────────────────────────────── -->
    <template id="scrap_summary_suppress_header_standard"
              inherit_id="web.external_layout_standard"
              priority="1001">
        <xpath expr="//div[contains(concat(' ', normalize-space(@class), ' '), ' header ') or contains(concat(' ', normalize-space(@t-attf-class), ' '), ' header ')]" position="attributes">
            <attribute name="t-if">not ((o and o._name == 'medicine.depot.scrap.summary.2025') or (doc and doc._name == 'medicine.depot.scrap.summary.2025'))</attribute>
        </xpath>
        <xpath expr="//div[contains(concat(' ', normalize-space(@class), ' '), ' header ') or contains(concat(' ', normalize-space(@t-attf-class), ' '), ' header ')]" position="after">
            <t t-call="medicine_depot_scrap_batch.pharma_scrap_summary_layout_header"/>
        </xpath>
        <xpath expr="//h2[@t-out='layout_document_title']" position="attributes">
            <attribute name="t-if">not ((o and o._name == 'medicine.depot.scrap.summary.2025') or (doc and doc._name == 'medicine.depot.scrap.summary.2025'))</attribute>
        </xpath>
    </template>


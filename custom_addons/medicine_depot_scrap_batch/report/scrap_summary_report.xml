    <!-- ═══════════════════════════════════════════════════════════════════
         TEMPLATE PRINCIPAL

         Tabla consolidada del acumulado de bajas por período, sucursal y
         compañía. Incluye cantidad A la mano y costos totales.
    ════════════════════════════════════════════════════════════════════════ -->
    <template id="report_scrap_summary">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <t t-set="address" t-value="''"/>
                    <t t-set="information_block" t-value="''"/>
                    <div class="page pharma-doc-page">

                        <!-- ═══ TABLA DE RESUMEN ═════════════════════════════ -->
                        <div class="pharma-section-ttl">Acumulado de bajas por período</div>
                        <table class="table table-sm pharma-lines">
                            <thead>
                                <tr>
                                    <th>Período</th>
                                    <th>Sucursal</th>
                                    <th class="text-end">Líneas</th>
                                    <th class="text-end">Cantidad A la mano</th>
                                    <th class="text-end">Costo (MXN)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="docs" t-as="record">
                                    <td>
                                        <span t-esc="record.periodo and record.periodo.strftime('%B %Y') or '—'"/>
                                    </td>
                                    <td>
                                        <span t-esc="record.sucursal or '—'"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-esc="record.line_count or 0"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-esc="'{:.2f}'.format(record.scrap_qty or 0)"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-field="record.costo" t-options='{"widget": "monetary", "display_currency": record.currency_id}'/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- ═══ TOTALES ══════════════════════════════════ -->
                        <div class="pharma-section-ttl mt-4">Resumen consolidado</div>
                        <div name="total" class="pharma-total-block">
                            <table>
                                <tbody>
                                    <tr>
                                        <td>Total de registros</td>
                                        <td class="text-end">
                                            <span t-esc="len(docs)"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>Total de líneas</td>
                                        <td class="text-end">
                                            <span t-esc="sum(docs.mapped('line_count')) or 0"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>Total Cantidad A la mano</td>
                                        <td class="text-end">
                                            <span t-esc="'{:.2f}'.format(sum(docs.mapped('scrap_qty')) or 0)"/>
                                        </td>
                                    </tr>
                                    <tr class="o_total_row">
                                        <td>Costo Total (MXN)</td>
                                        <td class="text-end">
                                            <span t-esc="'{:.2f}'.format(sum(docs.mapped('costo')) or 0)"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <div class="text-muted mt-3" style="font-size: 0.7rem;">
                            Reporte generado por
                            <span t-esc="user.name"/> ·
                            <span t-esc="datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S')"/>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ==================== Proyectos ==================== -->
        <record id="project_mds_migracion" model="project.project">
            <field name="name">[MDS] Medicine Depot - Migración Odoo.sh a Community v19</field>
        </record>

        <record id="project_mds_mobile" model="project.project">
            <field name="name">[MDS] Medicine Depot - Mobile API &amp; App</field>
        </record>

        <!-- ==================== Etapas (pipeline PMO, 1:1 con Quifamesa) ==================== -->
        <record id="stage_pmo_01_backlog" model="project.task.type">
            <field name="name">01. Backlog</field>
            <field name="sequence">10</field>
            <field name="project_ids" eval="[(4, ref('project_mds_migracion')), (4, ref('project_mds_mobile'))]"/>
        </record>

        <record id="stage_pmo_02_especificacion" model="project.task.type">
            <field name="name">02. Especificación / Scope</field>
            <field name="sequence">20</field>
            <field name="project_ids" eval="[(4, ref('project_mds_migracion')), (4, ref('project_mds_mobile'))]"/>
        </record>

        <record id="stage_pmo_03_desarrollo" model="project.task.type">
            <field name="name">03. En Desarrollo (Sprint Activo)</field>
            <field name="sequence">30</field>
            <field name="project_ids" eval="[(4, ref('project_mds_migracion')), (4, ref('project_mds_mobile'))]"/>
        </record>

        <record id="stage_pmo_04_code_review" model="project.task.type">
            <field name="name">04. Code Review / PR en GitHub</field>
            <field name="sequence">40</field>
            <field name="project_ids" eval="[(4, ref('project_mds_migracion')), (4, ref('project_mds_mobile'))]"/>
        </record>

        <record id="stage_pmo_05_staging" model="project.task.type">
            <field name="name">05. Staging / QA Validado</field>
            <field name="sequence">50</field>
            <field name="project_ids" eval="[(4, ref('project_mds_migracion')), (4, ref('project_mds_mobile'))]"/>
        </record>

        <record id="stage_pmo_06_desplegado" model="project.task.type">
            <field name="name">06. Desplegado / Producción (Hecho)</field>
            <field name="sequence">60</field>
            <field name="fold">True</field>
            <field name="project_ids" eval="[(4, ref('project_mds_migracion')), (4, ref('project_mds_mobile'))]"/>
        </record>

        <!-- ==================== Subtareas iniciales: Migración Odoo.sh -> Community v19 ==================== -->
        <record id="task_mds_migracion_extraccion_db" model="project.task">
            <field name="name">Extracción DB</field>
            <field name="project_id" ref="project_mds_migracion"/>
            <field name="stage_id" ref="stage_pmo_01_backlog"/>
            <field name="x_empresa">medicine_depot</field>
            <field name="x_modulo_componente">etl_db</field>
        </record>

        <record id="task_mds_migracion_depuracion_enterprise" model="project.task">
            <field name="name">Depuración Enterprise</field>
            <field name="project_id" ref="project_mds_migracion"/>
            <field name="stage_id" ref="stage_pmo_01_backlog"/>
            <field name="x_empresa">medicine_depot</field>
            <field name="x_modulo_componente">addon_odoo</field>
        </record>

        <record id="task_mds_migracion_qweb_reports" model="project.task">
            <field name="name">QWeb Reports</field>
            <field name="project_id" ref="project_mds_migracion"/>
            <field name="stage_id" ref="stage_pmo_01_backlog"/>
            <field name="x_empresa">medicine_depot</field>
            <field name="x_modulo_componente">reportes_qweb</field>
        </record>

        <record id="task_mds_migracion_wms" model="project.task">
            <field name="name">WMS</field>
            <field name="project_id" ref="project_mds_migracion"/>
            <field name="stage_id" ref="stage_pmo_01_backlog"/>
            <field name="x_empresa">medicine_depot</field>
            <field name="x_modulo_componente">addon_odoo</field>
        </record>

        <!-- ==================== Subtareas iniciales: Mobile API & App ==================== -->
        <record id="task_mds_mobile_endpoints_v1" model="project.task">
            <field name="name">Endpoints v1</field>
            <field name="project_id" ref="project_mds_mobile"/>
            <field name="stage_id" ref="stage_pmo_01_backlog"/>
            <field name="x_empresa">medicine_depot</field>
            <field name="x_modulo_componente">api_movil</field>
        </record>

        <record id="task_mds_mobile_catalogo_multi_db" model="project.task">
            <field name="name">Catálogo Multi-DB</field>
            <field name="project_id" ref="project_mds_mobile"/>
            <field name="stage_id" ref="stage_pmo_01_backlog"/>
            <field name="x_empresa">medicine_depot</field>
            <field name="x_modulo_componente">api_movil</field>
        </record>

        <record id="task_mds_mobile_ui_ux" model="project.task">
            <field name="name">UI/UX</field>
            <field name="project_id" ref="project_mds_mobile"/>
            <field name="stage_id" ref="stage_pmo_01_backlog"/>
            <field name="x_empresa">medicine_depot</field>
            <field name="x_modulo_componente">app_frontend</field>
        </record>

    </data>
</odoo>

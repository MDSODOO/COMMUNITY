<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══ Vista Lista ═══════════════════════════════════════════════════ -->
    <record id="view_report_lab_inventory_list" model="ir.ui.view">
        <field name="name">report.lab.inventory.list</field>
        <field name="model">report.lab.inventory</field>
        <field name="arch" type="xml">
            <list string="Laboratorios a la mano" create="false" edit="false" delete="false"
                  decoration-danger="qty_a_la_mano &lt;= 0"
                  decoration-warning="qty_a_la_mano &gt; 0 and qty_a_la_mano &lt; 10">
                <field name="line_name"     string="Laboratorio"        optional="show"/>
                <field name="product_id"    string="Producto"           optional="show"/>
                <field name="location_id"   string="Sucursal"           optional="show"/>
                <field name="qty_a_la_mano" string="A la mano" optional="show" sum="Total A la mano"/>
            </list>
        </field>
    </record>

    <!-- ══ Vista Pivot ═══════════════════════════════════════════════════ -->
    <record id="view_report_lab_inventory_pivot" model="ir.ui.view">
        <field name="name">report.lab.inventory.pivot</field>
        <field name="model">report.lab.inventory</field>
        <field name="arch" type="xml">
            <pivot string="Laboratorios a la mano" disable_linking="True">
                <field name="line_name"     type="row"     string="Laboratorio"/>
                <field name="product_id"    type="row"     string="Producto"/>
                <field name="location_id"   type="col"     string="Sucursal"/>
                <field name="qty_a_la_mano" type="measure" string="A la mano"/>
            </pivot>
        </field>
    </record>

    <!-- ══ Vista Búsqueda ════════════════════════════════════════════════ -->
    <record id="view_report_lab_inventory_search" model="ir.ui.view">
        <field name="name">report.lab.inventory.search</field>
        <field name="model">report.lab.inventory</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"  string="Producto"/>
                <field name="location_id" string="Sucursal"/>
                <!-- Filtros rápidos por laboratorio (domain exacto para Selection) -->
                <filter string="SERRAL"             name="filter_serral"   domain="[('line_name','=','SERRAL')]"/>
                <filter string="PERRIGO - QUIFA"    name="filter_perrigo"  domain="[('line_name','=','PERRIGO - QUIFA')]"/>
                <filter string="GELCAPS/PHARMACAPS" name="filter_gelcaps"  domain="[('line_name','=','GELCAPS/PHARMACAPS')]"/>
                <filter string="RAAM"               name="filter_raam"     domain="[('line_name','=','RAAM')]"/>
                <separator/>
                <group>
                    <filter string="Laboratorio" name="group_lab"      context="{'group_by': 'line_name'}"/>
                    <filter string="Producto"    name="group_product"  context="{'group_by': 'product_id'}"/>
                    <filter string="Sucursal"    name="group_location" context="{'group_by': 'location_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ══ Acción de ventana ═════════════════════════════════════════════ -->
    <record id="action_report_lab_inventory" model="ir.actions.act_window">
        <field name="name">Reporte laboratorios a la mano</field>
        <field name="res_model">report.lab.inventory</field>
        <field name="view_mode">list,pivot</field>
        <field name="domain">[('qty_a_la_mano', '&gt;', 0)]</field>
        <field name="context">{
            'search_default_group_lab': 1,
            'pivot_measures': ['qty_a_la_mano'],
            'pivot_column_groupby': ['location_id'],
            'pivot_row_groupby': ['line_name', 'product_id']
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Sin datos a la mano
            </p>
            <p>
                Este reporte muestra el concentrado <strong>A la mano</strong>
                para los laboratorios <em>SERRAL, PERRIGO-QUIFA, GELCAPS/PHARMACAPS y RAAM</em>
                distribuidas por sucursal.
            </p>
            <p>
                <strong>Si no aparecen datos:</strong>
            </p>
            <ul>
                <li>Verifica que el módulo Studio con el modelo <code>x_line</code> esté instalado y activado</li>
                <li>Asegúrate de que los productos tienen asignada su línea de laboratorio</li>
                <li>Revisa que haya A la mano positivo (qty_a_la_mano &gt; 0) en ubicaciones internas</li>
                <li>Consulta los logs del servidor para detalles de errores de base de datos</li>
                <li>Desactiva y reactiva el módulo si cambió la configuración de Studio</li>
            </ul>
        </field>
    </record>

    <!-- ══ Ítem de menú ══════════════════════════════════════════════════ -->
    <menuitem
        id="menu_report_lab_inventory"
        name="Reporte laboratorios a la mano"
        parent="stock.menu_warehouse_report"
        action="action_report_lab_inventory"
        sequence="100"
        groups="stock.group_stock_user"/>

</odoo>

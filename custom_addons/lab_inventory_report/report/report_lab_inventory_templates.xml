<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_lab_pdf" model="ir.actions.report">
        <field name="name">Laboratorios A la mano - PDF</field>
        <field name="model">report.lab.inventory</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">lab_inventory_report.report_lab_inventory_pdf</field>
        <field name="report_file">lab_inventory_report.report_lab_inventory_pdf</field>
        <field name="binding_model_id" ref="model_report_lab_inventory"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Reporte laboratorios A la mano'</field>
    </record>

    <template id="pharma_lab_inventory_layout_header">
        <t t-set="_lab" t-value="o if o else doc"/>
        <t t-if="_lab and _lab._name == 'report.lab.inventory'">
            <t t-set="_lab_co" t-value="_lab.env.company.sudo()"/>
            <div class="pharma-full-header">
                <div class="d-flex align-items-start justify-content-between pharma-doc-header">
                    <div class="pharma-logo-shell">
                        <img t-if="_lab_co.logo" class="md-logo"
                             t-att-src="image_data_uri(_lab_co.logo)" alt="Logo"/>
                        <div t-if="_lab_co.report_header"
                             t-field="_lab_co.report_header"
                             class="o_company_tagline fw-bold mt-1"/>
                    </div>
                    <div class="pharma-doc-info text-end">
                        <span class="pharma-doc-type">Reporte Laboratorios</span>
                        <span class="pharma-doc-num">A la mano</span>
                        <span class="pharma-doc-date">
                            <t t-if="report_generated_at">
                                <span t-esc="report_generated_at.strftime('%Y-%m-%d')"/>
                            </t>
                        </span>
                    </div>
                </div>
                <div class="pharma-stripe">
                    <span class="pharma-stripe-band pharma-stripe-band-brand"/>
                    <span class="pharma-stripe-band pharma-stripe-band-teal"/>
                    <span class="pharma-stripe-band pharma-stripe-band-lime"/>
                </div>
                <div class="row g-0 pharma-meta-band">
                    <div class="col-3 pharma-meta-cell">
                        <span class="pharma-meta-label">Laboratorios</span>
                        <span class="pharma-meta-val pharma-meta-val-sm">
                            <t t-esc="', '.join(lab_names) if lab_names else '—'"/>
                        </span>
                    </div>
                    <div class="col-3 pharma-meta-cell">
                        <span class="pharma-meta-label">Sucursales</span>
                        <span class="pharma-meta-val" t-esc="len(location_names) if location_names else 0"/>
                    </div>
                    <div class="col-3 pharma-meta-cell">
                        <span class="pharma-meta-label">Registros</span>
                        <span class="pharma-meta-val" t-esc="report_row_count or 0"/>
                    </div>
                    <div class="col-3 pharma-meta-cell">
                        <span class="pharma-meta-label">Compañía</span>
                        <span class="pharma-meta-val" t-esc="_lab_co.name or '—'"/>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="lab_inventory_suppress_header_standard"
              inherit_id="web.external_layout_standard"
              priority="1001">
        <xpath expr="//div[contains(concat(' ', normalize-space(@class), ' '), ' header ') or contains(concat(' ', normalize-space(@t-attf-class), ' '), ' header ')]" position="attributes">
            <attribute name="t-if">not ((o and o._name == 'report.lab.inventory') or (doc and doc._name == 'report.lab.inventory'))</attribute>
        </xpath>
        <xpath expr="//div[contains(concat(' ', normalize-space(@class), ' '), ' header ') or contains(concat(' ', normalize-space(@t-attf-class), ' '), ' header ')]" position="after">
            <t t-call="lab_inventory_report.pharma_lab_inventory_layout_header"/>
        </xpath>
        <xpath expr="//h2[@t-out='layout_document_title']" position="attributes">
            <attribute name="t-if">not ((o and o._name == 'report.lab.inventory') or (doc and doc._name == 'report.lab.inventory'))</attribute>
        </xpath>
    </template>


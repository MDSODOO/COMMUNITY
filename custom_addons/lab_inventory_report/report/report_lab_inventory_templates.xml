        </xpath>
        <xpath expr="//div[contains(concat(' ', normalize-space(@class), ' '), ' header ') or contains(concat(' ', normalize-space(@t-attf-class), ' '), ' header ')]" position="after">
            <t t-call="lab_inventory_report.pharma_lab_inventory_layout_header"/>
        </xpath>
    </template>

    <template id="report_lab_inventory_pdf">
        <t t-call="web.html_container">
            <t t-set="o" t-value="docs and docs[0] or False"/>
            <t t-call="web.external_layout">
                <t t-set="address" t-value="''"/>
                <t t-set="information_block" t-value="''"/>
                <div class="page pharma-doc-page">
                    <div class="pharma-body-address-shell">
                        <div class="pharma-doc pharma-addr-grid">
                            <div class="row g-0">
                                <div class="col-6 pe-4 pharma-addr-col">
                                    <span class="pharma-addr-label">Laboratorios</span>
                                    <div class="pharma-addr-name">
                                        <t t-esc="', '.join(lab_names) if lab_names else '—'"/>
                                    </div>
                                    <div class="pharma-addr-lines">Concentrado por laboratorio</div>
                                </div>
                                <div class="col-6 ps-4 pharma-addr-col pharma-addr-divider">
                                    <span class="pharma-addr-label">Sucursales</span>
                                    <div class="pharma-addr-name">
                                        <t t-esc="len(location_names) if location_names else 0"/>
                                    </div>
                                    <div class="pharma-addr-lines">
                                        <t t-esc="', '.join(location_names) if location_names else '—'"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="pharma-section-ttl">Detalle por producto</div>
                    <table class="table table-sm pharma-lines">
                        <thead>
                            <tr>
                                <th>Laboratorio</th>
                                <th>Producto</th>
                                <th>Sucursal</th>
                                <th class="text-end">A la mano</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="docs" t-as="record">
                                <td>
                                    <span t-esc="record.line_name or '—'"/>
                                </td>
                                <td class="pharma-product-cell">
                                    <span t-field="record.product_id"/>
                                </td>
                                <td>
                                    <span t-field="record.location_id"/>
                                </td>
                                <td class="text-end">
                                    <span t-esc="'{:.2f}'.format(record.qty_a_la_mano or 0)"/>
                                </td>
                            </tr>
                            <tr t-if="not docs">
                                <td colspan="4" class="text-center text-muted">Sin A la mano para mostrar</td>
                            </tr>
                        </tbody>
                    </table>

                    <div class="pharma-section-ttl mt-4">Resumen</div>
                    <div name="total" class="pharma-total-block">
                        <table>
                            <tbody>
                                <tr>
                                    <td>Total de registros</td>
                                    <td class="text-end">
                                        <span t-esc="report_row_count or 0"/>
                                    </td>
                                </tr>
                                <tr class="o_total_row">
                                    <td>Total A la mano</td>
                                    <td class="text-end">
                                        <span t-esc="'{:.2f}'.format(total_a_la_mano or 0)"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="text-muted mt-3" style="font-size: 0.7rem;">
                        Reporte generado por
                        <span t-esc="user.name"/> ·
                        <span t-esc="report_generated_at.strftime('%Y-%m-%d %H:%M:%S') if report_generated_at else ''"/>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!--
        Acción planificada: se ejecuta mensualmente el último día de cada mes.
        Configura el campo "Siguiente ejecución" al último día del mes en curso
        después de la instalación para mantener la cadencia correcta.
    -->
    <record id="ir_cron_lab_inventory_monthly" model="ir.cron">
        <field name="name">Reporte mensual: Laboratorios a la mano</field>
        <field name="model_id" ref="lab_inventory_report.model_report_lab_inventory"/>
        <field name="state">code</field>
        <field name="code">model._cron_generate_monthly_report()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">months</field>
        <field name="active" eval="True"/>
        <field name="priority">10</field>
    </record>

</odoo>

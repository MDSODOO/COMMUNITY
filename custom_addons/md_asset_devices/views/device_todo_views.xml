<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="device_todo_view_form" model="ir.ui.view">
            <field name="name">device.todo.form</field>
            <field name="model">device.todo</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_marcar_in_progress" type="object" string="Iniciar" invisible="estado != 'todo'"/>
                        <button name="action_marcar_done" type="object" string="Completar" invisible="estado != 'in_progress'"/>
                        <button name="action_marcar_todo" type="object" string="Reabrir" invisible="estado != 'done'"/>
                        <button name="action_cancelar" type="object" string="Cancelar" invisible="estado == 'cancelled'"/>
                        <field name="estado" widget="statusbar" statusbar_visible="todo,in_progress,done"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="device_id" required="True"/>
                                <field name="tipo" widget="selection_badge"/>
                            </group>
                            <group>
                                <field name="prioridad" widget="selection_badge" default="normal"/>
                                <field name="asignado_a"/>
                            </group>
                        </group>
                        <field name="titulo" placeholder="Título de la tarea..." required="True"/>
                        <field name="descripcion" placeholder="Descripción detallada..."/>
                        <group string="Fechas">
                            <group>
                                <field name="fecha_vencimiento"/>
                            </group>
                            <group>
                                <field name="fecha_completado" readonly="True"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="device_todo_view_tree" model="ir.ui.view">
            <field name="name">device.todo.tree</field>
            <field name="model">device.todo</field>
            <field name="arch" type="xml">
                <list string="Tareas"
                    decoration-danger="fecha_vencimiento and fecha_vencimiento &lt; current_date and estado != 'done'"
                    decoration-warning="prioridad == 'urgente'">
                    <field name="device_id"/>
                    <field name="titulo"/>
                    <field name="tipo" widget="badge"/>
                    <field name="prioridad" widget="badge" decoration-danger="prioridad == 'urgente'"/>
                    <field name="asignado_a"/>
                    <field name="fecha_vencimiento"/>
                    <field name="estado" widget="badge" decoration-success="estado == 'done'"/>
                </list>
            </field>
        </record>

        <record id="device_todo_view_calendar" model="ir.ui.view">
            <field name="name">device.todo.calendar</field>
            <field name="model">device.todo</field>
            <field name="arch" type="xml">
                <calendar string="Calendario de Tareas"
                    date_start="fecha_vencimiento"
                    color="prioridad">
                    <field name="device_id"/>
                    <field name="titulo"/>
                    <field name="prioridad"/>
                </calendar>
            </field>
        </record>
    </data>
</odoo>

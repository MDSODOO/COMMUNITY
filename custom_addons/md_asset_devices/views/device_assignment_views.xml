<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- FORM VIEW -->
        <record id="view_device_assignment_form" model="ir.ui.view">
            <field name="name">device.assignment.form</field>
            <field name="model">device.assignment</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <field name="estado" widget="statusbar" statusbar_visible="activa,devuelto"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="usuario_asignado" placeholder="Usuario asignado..."/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="device_id" required="True"/>
                                <field name="inventory_id" domain="[('device_id', '=', device_id)]"/>
                            </group>
                            <group>
                                <field name="fecha_asignacion"/>
                                <field name="fecha_devolucion"/>
                            </group>
                        </group>
                        <field name="observaciones" placeholder="Observaciones..."/>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- LIST VIEW -->
        <record id="view_device_assignment_list" model="ir.ui.view">
            <field name="name">device.assignment.list</field>
            <field name="model">device.assignment</field>
            <field name="arch" type="xml">
                <list string="Asignaciones"
                    decoration-muted="estado == 'devuelto'"
                    decoration-danger="estado == 'perdido' or estado == 'roto'">
                    <field name="device_id" string="Dispositivo"/>
                    <field name="usuario_asignado" string="Usuario"/>
                    <field name="fecha_asignacion" string="Desde"/>
                    <field name="fecha_devolucion" string="Devuelto"/>
                    <field name="estado" string="Estado" widget="badge"
                        decoration-success="estado == 'activa'"
                        decoration-muted="estado == 'devuelto'"
                        decoration-danger="estado == 'perdido' or estado == 'roto'"/>
                </list>
            </field>
        </record>
    </data>
</odoo>

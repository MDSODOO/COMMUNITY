<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="device_documentation_view_form" model="ir.ui.view">
            <field name="name">device.documentation.form</field>
            <field name="model">device.documentation</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group><field name="device_id" required="True"/></group>
                            <group><field name="tipo" widget="selection_badge" required="True"/></group>
                        </group>
                        <group>
                            <field name="nombre_documento" placeholder="Ej: Manual técnico" required="True"/>
                            <field name="nombre_archivo"/>
                        </group>
                        <field name="descripcion" placeholder="Descripción..."/>
                        <group string="Fechas">
                            <group>
                                <field name="fecha_documento"/>
                                <field name="documento_vigente" readonly="True"/>
                            </group>
                            <group>
                                <field name="fecha_vencimiento"/>
                            </group>
                        </group>
                        <group string="Archivo o URL">
                            <field name="archivo" filename="nombre_archivo"/>
                            <field name="url_documento" widget="url" placeholder="https://..."/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="device_documentation_view_tree" model="ir.ui.view">
            <field name="name">device.documentation.tree</field>
            <field name="model">device.documentation</field>
            <field name="arch" type="xml">
                <list string="Documentación" decoration-danger="fecha_vencimiento and fecha_vencimiento &lt; current_date">
                    <field name="device_id"/>
                    <field name="tipo" widget="badge"/>
                    <field name="nombre_documento"/>
                    <field name="fecha_documento"/>
                    <field name="fecha_vencimiento" decoration-danger="fecha_vencimiento and fecha_vencimiento &lt; current_date"/>
                    <field name="documento_vigente" widget="boolean"/>
                </list>
            </field>
        </record>
    </data>
</odoo>

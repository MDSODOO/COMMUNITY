<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="fleet_vehicle_view_form_employee" model="ir.ui.view">
            <field name="name">fleet.vehicle.form.md.employee</field>
            <field name="model">fleet.vehicle</field>
            <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
            <field name="arch" type="xml">
                <field name="driver_id" position="after">
                    <field name="employee_id"/>
                </field>
            </field>
        </record>

        <record id="fleet_vehicle_view_tree_employee" model="ir.ui.view">
            <field name="name">fleet.vehicle.list.md.employee</field>
            <field name="model">fleet.vehicle</field>
            <field name="inherit_id" ref="fleet.fleet_vehicle_view_tree"/>
            <field name="arch" type="xml">
                <field name="driver_id" position="after">
                    <field name="employee_id" optional="show"/>
                </field>
            </field>
        </record>

    </data>
</odoo>

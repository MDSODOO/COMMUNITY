<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Secuencia para solicitudes -->
    <record id="seq_sat_download_request" model="ir.sequence">
        <field name="name">Solicitud Descarga SAT</field>
        <field name="code">sat.download.request</field>
        <field name="prefix">SAT/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Cron: Procesar solicitudes pendientes (cada 10 minutos) -->
    <record id="ir_cron_sat_process_requests" model="ir.cron">
        <field name="name">SAT: Procesar solicitudes de descarga pendientes</field>
        <field name="model_id" ref="model_sat_download_request"/>
        <field name="state">code</field>
        <field name="code">model._cron_process_pending_requests()</field>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
        <field name="priority">50</field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_sat_download_user" model="res.groups">
        <field name="name">SAT Descarga Masiva: Usuario</field>
    </record>

    <record id="group_sat_download_manager" model="res.groups">
        <field name="name">SAT Descarga Masiva: Administrador</field>
        <field name="implied_ids" eval="[(4, ref('group_sat_download_user'))]"/>
    </record>

    <!-- Reglas de registro: multi-compañía -->
    <record id="sat_download_request_comp_rule" model="ir.rule">
        <field name="name">sat.download.request: multi-company</field>
        <field name="model_id" ref="model_sat_download_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="sat_xml_document_comp_rule" model="ir.rule">
        <field name="name">sat.xml.document: multi-company</field>
        <field name="model_id" ref="model_sat_xml_document"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>

<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <!--
        ProductCard — stock badge.

        Reads:
          - props.stockQuantity  : qty passed from ProductScreen.state.stockByProductTmplId
          - pos.config.*         : display config (via get pos() getter in product_card.js)

        XPath pattern mirrors pos_restaurant (//ActionpadWidget position="attributes")
        and Odoo core (productCartQty="this.state.quantityByProductTmplId[product.id]").
    -->
    <t t-name="bi_pos_stock.ProductCard"
       t-inherit="point_of_sale.ProductCard"
       t-inherit-mode="extension"
       owl="1">
        <xpath expr="//article" position="inside">
            <!--
                Stock badge — shown only for non-lot/non-serial storable products.
                Lot/serial products: the lot-card-footer (below) handles stock display
                after a specific lot is selected by the cashier.

                Traffic-light color via stockColorClass getter:
                  stock-badge-red    → qty ≤ 0 (out of stock)
                  stock-badge-yellow → 0 < qty ≤ low_stock threshold
                  stock-badge-green  → qty > threshold
            -->
            <t t-if="pos.config.pos_display_stock
                      and props.product.is_storable
                      and props.product.type !== 'service'
                      and props.product.tracking !== 'lot'
                      and props.product.tracking !== 'serial'">

                <t t-set="stockQty" t-value="props.stockQuantity ?? 0"/>

                <t t-if="pos.config.stock_position === 'top_left'">
                    <span t-att-class="'qty-left-label ' + stockColorClass">
                        <t t-esc="stockQty"/>
                    </span>
                </t>
                <t t-if="pos.config.stock_position === 'top_right'">
                    <span t-att-class="'qty-tright-label ' + stockColorClass">
                        <t t-esc="stockQty"/>
                    </span>
                </t>
                <t t-if="pos.config.stock_position === 'bottom_right'">
                    <span t-att-class="'qty-bright-label ' + stockColorClass">
                        <t t-esc="stockQty"/>
                    </span>
                </t>

            </t>
        </xpath>
    </t>

    <!--
        Info ⓘ button — top-right corner; opens LotDetailPopup on demand.

        Always visible for storable products (matches the glassmorphism
        handoff: every card gets an "i" button). LotDetailPopup itself decides
        what to show: the FEFO lot breakdown for lot/serial-tracked products,
        or a "Detalle regulatorio" fields table as a fallback for products
        with no lot tracking (category, referencia interna, código de
        barras, existencia) — see lot_detail_popup.js/.xml.

        Previously gated on `lotExpiry` (lot-tracked + in-stock only); widened
        so non-lot products also get a way to see their regulatory detail.
    -->
    <t t-name="bi_pos_stock.ProductCardLotExpiry"
       t-inherit="point_of_sale.ProductCard"
       t-inherit-mode="extension"
       owl="1">
        <xpath expr="//article" position="inside">
            <button class="lot-info-btn btn btn-sm"
                    type="button"
                    title="Ver detalle del producto"
                    t-on-click="openLotDetail">
                <i class="fa fa-info-circle"/>
            </button>
        </xpath>
    </t>

    <!--
        Price line — reference price, tax-config-aware (see displayPrice
        getter in product_card.js). Absent from Odoo core's ProductCard,
        which shows no price until the product is actually in the cart.
    -->
    <t t-name="bi_pos_stock.ProductCardPrice"
       t-inherit="point_of_sale.ProductCard"
       t-inherit-mode="extension"
       owl="1">
        <xpath expr="//div[hasclass('product-name')]" position="after">
            <div t-if="displayPrice" class="product-card-price" t-esc="displayPrice"/>
        </xpath>
    </t>

    <!--
        Selected-lot footer — always rendered inside the card (reserves vertical
        space so layout never jumps).  Visibility is controlled by CSS:
          • lot-footer-empty  →  opacity: 0; pointer-events: none  (CSS transition)
          • (no class)        →  opacity: 1  (lot has been selected)

        Shows the selected lot's expiry date + available qty with FontAwesome icons.
        Guarded by props.product.tracking so non-lot products get no DOM overhead.
    -->
    <t t-name="bi_pos_stock.ProductCardLotFooter"
       t-inherit="point_of_sale.ProductCard"
       t-inherit-mode="extension"
       owl="1">
        <xpath expr="//article" position="inside">
            <!--
                Footer div: always rendered for lot-tracked products so the card
                height is stable (no layout jump when lot is selected).
                CSS transitions opacity via .lot-footer-empty → no DOM add/remove.
            -->
            <t t-if="props.product.tracking === 'lot' or props.product.tracking === 'serial'">
                <div t-att-class="'lot-card-footer d-flex align-items-center justify-content-center gap-1 px-1'
                                  + (props.selectedLotInfo ? '' : ' lot-footer-empty')">
                    <t t-if="props.selectedLotInfo">
                        <span t-att-class="'badge bg-' + selectedLotExpiryColor"
                              style="font-size:0.65rem;">
                            <i class="fa fa-calendar me-1"/>
                            <t t-esc="selectedLotDateLabel"/>
                        </span>
                        <span class="badge bg-secondary"
                              style="font-size:0.65rem;">
                            <i class="fa fa-cubes me-1"/>
                            <t t-esc="selectedLotQtyLabel"/>
                        </span>
                    </t>
                </div>
            </t>
        </xpath>
    </t>

    <!--
        ProductScreen template extension — inject stockQuantity into every ProductCard.

        Uses //ProductCard (no parent constraint) as pos_restaurant uses //ActionpadWidget.
        The expression is evaluated in ProductScreen's template context, where:
          - this.state.stockByProductTmplId is the qty map populated by product_list.js
          - product is the loop variable from t-as="product"
    -->
    <t t-name="bi_pos_stock.ProductScreen"
       t-inherit="point_of_sale.ProductScreen"
       t-inherit-mode="extension"
       owl="1">
        <xpath expr="//ProductCard" position="attributes">
            <attribute name="stockQuantity">
                this.state.stockByProductTmplId[product.id] ?? 0
            </attribute>
            <!--
                selectedLotInfo: injected here so OWL propagates it as a prop —
                same pattern as stockQuantity.  ProductScreen.state.selectedLotByProductId
                is rebuilt by useEffect whenever a lot is assigned/changed on any line.
            -->
            <attribute name="selectedLotInfo">
                this.state.selectedLotByProductId[product.id] ?? null
            </attribute>
            <!--
                isShortExpiry: true when the product has a lot expiring in ≤ 180 days.
                ProductScreen.state.shortExpiryTmplIds is computed by useEffect in
                product_list.js whenever lotsExpirySummary changes.
            -->
            <attribute name="isShortExpiry">
                !!(this.state.shortExpiryTmplIds &amp;&amp; this.state.shortExpiryTmplIds.includes(product.id))
            </attribute>
        </xpath>
    </t>

    <!--
        ProductCard — short-expiry visual ring (< 6 months).

        When props.isShortExpiry is true, renders an absolute-positioned div
        that creates a purple border around the entire card. Using an overlay
        div (instead of modifying the article's class attribute) avoids breaking
        existing t-att-class bindings on the article element.

        Requires:
          - Parent <article> to be position:relative (guaranteed by Odoo core).
          - .short-expiry-ring CSS defined in pos_product_card.scss.

        The "Prox. Vencer" pill at the bottom-right serves as an explicit
        text signal in addition to the color border, making it accessible to
        users who may not perceive color differences alone.
    -->
    <t t-name="bi_pos_stock.ProductCardShortExpiry"
       t-inherit="point_of_sale.ProductCard"
       t-inherit-mode="extension"
       owl="1">
        <xpath expr="//article" position="inside">
            <t t-if="props.isShortExpiry">
                <div class="short-expiry-ring" aria-label="Próximo a vencer" aria-hidden="true">
                    <span class="short-expiry-pill">Prox. Vencer</span>
                </div>
            </t>
        </xpath>
    </t>
</templates>

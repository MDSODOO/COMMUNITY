<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!--
        ReplenishmentLine — one row in the StockScreen tables.

        lineType='inventory':
          product: { product_id, name, line_id, line_name, vendor_code, barcode, qty_on_hand,
                     month1_sales, month2_sales, month3_sales }

        lineType='restock':
          product: { orderpoint_id, product_id, display_name, barcode, qty_on_hand,
                     product_min_qty, product_max_qty, qty_to_order, location_name }
    -->
    <t t-name="bi_pos_stock.ReplenishmentLine">

        <!-- ══════════════════════════════════════════════════════════════ -->
        <!-- ── Inventario General row ── -->
        <!-- ══════════════════════════════════════════════════════════════ -->
        <tr t-if="props.lineType === 'inventory'"
            class="partner-line" t-att-data-id="props.product.product_id"
            t-att-style="props.product._requested ? 'opacity:0.5;' : ''">

            <!-- Código de barras -->
            <td>
                <t t-if="props.product.barcode">
                    <t t-esc="props.product.barcode"/>
                </t>
                <t t-else="">
                    <span class="text-muted">—</span>
                </t>
            </td>

            <!-- Producto -->
            <td>
                <t t-esc="props.product.name"/>
            </td>

            <!-- Línea -->
            <td>
                <t t-if="props.product.line_name">
                    <t t-esc="props.product.line_name"/>
                </t>
                <t t-else="">
                    <span class="text-muted">—</span>
                </t>
            </td>

            <!-- Código Proveedor -->
            <td class="text-end">
                <t t-if="props.product.vendor_code">
                    <span class="badge bg-light text-secondary">
                        <t t-esc="props.product.vendor_code"/>
                    </span>
                </t>
            </td>

            <!-- A la mano -->
            <td class="text-center">
                <span t-att-class="props.product.qty_on_hand &lt;= 0
                    ? 'badge bg-danger text-white'
                    : props.product.qty_on_hand &lt;= 5
                        ? 'badge bg-warning text-dark'
                        : 'badge bg-success text-white'">
                    <t t-esc="this.formatQty(props.product.qty_on_hand)"/>
                </span>
            </td>

            <!-- Mes 1 (oldest) -->
            <td class="text-center">
                <span class="badge" style="background-color:var(--md-blue-800); color:#fff;">
                    <t t-esc="this.formatQty(props.product.month1_sales)"/>
                </span>
            </td>

            <!-- Mes 2 -->
            <td class="text-center">
                <span class="badge" style="background-color:var(--md-blue-700); color:#fff;">
                    <t t-esc="this.formatQty(props.product.month2_sales)"/>
                </span>
            </td>

            <!-- Mes 3 (most recent) -->
            <td class="text-center">
                <span class="badge" style="background-color:var(--md-blue); color:#fff;">
                    <t t-esc="this.formatQty(props.product.month3_sales)"/>
                </span>
            </td>

            <!-- Columnas BF: solo visibles cuando hay snapshot activo -->
            <t t-if="props.bfLabel">

                <!-- Inventario BF -->
                <td class="text-center" style="border-left:2px solid #dee2e6;">
                    <t t-if="props.product.bf_qty !== null and props.product.bf_qty !== undefined">
                        <span t-att-class="props.product.bf_qty &lt;= 0
                                ? 'badge bg-danger text-white'
                                : props.product.bf_qty &lt;= 10
                                    ? 'badge bg-warning text-dark'
                                    : 'badge text-white'"
                              t-att-style="props.product.bf_qty > 10
                                    ? 'background-color:var(--md-success);' : ''">
                            <t t-esc="this.formatQty(props.product.bf_qty)"/>
                        </span>
                    </t>
                    <t t-else="">
                        <span class="text-muted" style="font-size:0.75rem;">—</span>
                    </t>
                </td>

                <!-- Costo BF -->
                <td class="text-center">
                    <t t-if="props.product.bf_cost">
                        <small style="color:var(--md-success); font-weight:600;">
                            $<t t-esc="(props.product.bf_cost || 0).toFixed(2)"/>
                        </small>
                    </t>
                    <t t-else="">
                        <span class="text-muted">—</span>
                    </t>
                </td>

                <!-- Precio mostrador BF -->
                <td class="text-center">
                    <t t-if="props.product.bf_retail">
                        <small class="text-muted">
                            $<t t-esc="(props.product.bf_retail || 0).toFixed(2)"/>
                        </small>
                    </t>
                    <t t-else="">
                        <span class="text-muted">—</span>
                    </t>
                </td>

            </t>

            <!-- Acción -->
            <td class="text-center no-print">
                <button
                    class="btn btn-sm btn-md-action-inventory"
                    t-att-disabled="props.requesting or props.product._requested ? true : undefined"
                    t-att-class="props.product._requested ? 'btn-md-action-requested' : ''"
                    t-on-click="props.onSolicitar">
                    <t t-if="props.requesting">
                        <i class="fa fa-spinner fa-spin me-1"/>
                        Solicitando…
                    </t>
                    <t t-elif="props.product._requested">
                        <i class="fa fa-check me-1"/>
                        Solicitado
                    </t>
                    <t t-else="">
                        <i class="fa fa-truck me-1"/>
                        Solicitar
                    </t>
                </button>
            </td>

        </tr>

        <!-- ══════════════════════════════════════════════════════════════ -->
        <!-- ── Por Reabastecer row ── -->
        <!-- ══════════════════════════════════════════════════════════════ -->
        <tr t-if="props.lineType === 'restock'"
            class="partner-line" t-att-data-id="props.product.orderpoint_id">

            <!-- Código de barras -->
            <td>
                <t t-if="props.product.barcode">
                    <t t-esc="props.product.barcode"/>
                </t>
                <t t-else="">
                    <span class="text-muted">—</span>
                </t>
            </td>

            <!-- Producto + ubicación -->
            <td>
                <div><t t-esc="props.product.display_name"/></div>
                <small class="text-muted" t-if="props.product.location_name"
                       style="font-size:0.72rem;">
                    <t t-esc="props.product.location_name"/>
                </small>
            </td>

            <!-- A la mano -->
            <td class="text-center">
                <span t-att-class="props.product.qty_on_hand &lt;= 0
                    ? 'badge bg-danger text-white'
                    : 'badge bg-warning text-dark'">
                    <t t-esc="this.formatQty(props.product.qty_on_hand)"/>
                </span>
            </td>

            <!-- Mínimo — high contrast -->
            <td class="text-center">
                <span class="badge"
                      style="background-color:var(--md-blue-100); color:var(--md-blue-800); border:1px solid var(--md-blue-200);">
                    <t t-esc="this.formatQty(props.product.product_min_qty)"/>
                </span>
            </td>

            <!-- Máximo -->
            <td class="text-center">
                <span class="badge" style="background-color:var(--md-blue-700); color:#fff;">
                    <t t-esc="this.formatQty(props.product.product_max_qty)"/>
                </span>
            </td>

            <!-- Por ordenar -->
            <td class="text-center">
                <strong style="color:var(--md-blue-800);">
                    <t t-esc="this.formatQty(props.product.qty_to_order)"/>
                </strong>
            </td>

            <!-- Acción -->
            <td class="text-center no-print">
                <button
                    class="btn btn-sm btn-md-action-restock"
                    t-att-disabled="props.requesting ? true : undefined"
                    t-on-click="props.onSolicitar">
                    <t t-if="props.requesting">
                        <i class="fa fa-spinner fa-spin me-1"/>
                        Solicitando…
                    </t>
                    <t t-else="">
                        <i class="fa fa-truck me-1"/>
                        Solicitar
                    </t>
                </button>
            </td>

        </tr>
    </t>
</templates>

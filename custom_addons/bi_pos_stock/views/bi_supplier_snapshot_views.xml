<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ── Wizard: Importar Excel BF ── -->
    <record id="view_import_bf_snapshot_wizard_form" model="ir.ui.view">
        <field name="name">import.bf.snapshot.wizard.form</field>
        <field name="model">import.bf.snapshot.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar Excel BF">
                <group>
                    <group string="Selecciona el archivo de inventario del proveedor BF">
                        <field name="excel_file" filename="filename" widget="binary"
                               string="Archivo Excel (.xlsx)"/>
                        <field name="filename" invisible="1"/>
                    </group>
                    <group string="Formato esperado">
                        <div class="text-muted p-2">
                            <p><strong>Hoja requerida:</strong> INVENTARIO</p>
                            <p><strong>Columna de inventario:</strong> "INV DD DE MMM YYYY"
                               (ej. "INV 26 DE MAY 2026")</p>
                            <p>El sistema detecta automáticamente las columnas de
                               Costo Factura Casa y Precio Mostrador.</p>
                        </div>
                    </group>
                </group>
                <footer>
                    <button name="action_import" string="Importar" type="object"
                            class="btn-primary" data-hotkey="v"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"
                            data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_import_bf_snapshot_wizard" model="ir.actions.act_window">
        <field name="name">Importar Excel BF</field>
        <field name="res_model">import.bf.snapshot.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- ── Snapshot: lista ── -->
    <record id="view_bi_supplier_snapshot_list" model="ir.ui.view">
        <field name="name">bi.pos.supplier.snapshot.list</field>
        <field name="model">bi.pos.supplier.snapshot</field>
        <field name="arch" type="xml">
            <list string="Snapshots BF" default_order="snapshot_date desc"
                  decoration-muted="not active">
                <field name="name"/>
                <field name="supplier_code"/>
                <field name="snapshot_date"/>
                <field name="line_count" string="# Productos" readonly="1"/>
                <field name="active" widget="toggle_button" optional="show"/>
            </list>
        </field>
    </record>

    <!-- ── Snapshot: formulario ── -->
    <record id="view_bi_supplier_snapshot_form" model="ir.ui.view">
        <field name="name">bi.pos.supplier.snapshot.form</field>
        <field name="model">bi.pos.supplier.snapshot</field>
        <field name="arch" type="xml">
            <form string="Snapshot BF">
                <header>
                    <button name="action_open_import_wizard"
                            string="Importar nuevo Excel"
                            type="object"
                            icon="fa-upload"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="supplier_code"/>
                            <field name="snapshot_date"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="line_count" readonly="1"/>
                            <field name="file_attachment_id" readonly="1"
                                   widget="many2one_avatar"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Productos" name="lines">
                            <field name="line_ids" readonly="1">
                                <list>
                                    <field name="vendor_code" string="Código BF"/>
                                    <field name="barcode"/>
                                    <field name="product_name"/>
                                    <field name="lab"/>
                                    <field name="qty_on_hand" string="A la mano"
                                           decoration-danger="qty_on_hand == 0"/>
                                    <field name="cost_price" string="Costo"/>
                                    <field name="retail_price" string="P. Most."/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Action principal ── -->
    <record id="action_bi_supplier_snapshot" model="ir.actions.act_window">
        <field name="name">Inventario BF</field>
        <field name="res_model">bi.pos.supplier.snapshot</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
    </record>

    <!-- ── Menú bajo POS → Configuración ── -->
    <menuitem id="menu_bi_supplier_snapshot"
              name="Inventario BF"
              parent="point_of_sale.menu_point_config_product"
              action="action_bi_supplier_snapshot"
              sequence="99"
              groups="point_of_sale.group_pos_manager"/>

</odoo>

<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Integra directamente dentro de Facturación (account.menu_finance),
             en vez de una app separada: se confirmó que casi todos los items
             de Enterprise ya existen ahí de forma nativa (los trae cada
             módulo OCA por su cuenta). Solo se agrega lo que realmente
             falta, y se reordena lo que ya existe para igualar la
             agrupación visual de Enterprise (Contabilidad > Transacciones /
             Activos y pasivos / Bloqueando; Revisión; Reportes). -->

        <!-- Transacciones (account.account_transactions_menu): ya tiene
             Asientos contables y Apuntes analíticos nativos; falta
             Transferencias. -->
        <menuitem id="menu_md_transfers"
                  name="Transferencias"
                  parent="account.account_transactions_menu"
                  action="account.action_account_payments_transfer"
                  sequence="15"/>

        <!-- Activos y pasivos: se reutiliza el tab "Activos" que
             account_asset_management ya crea (menu_finance_assets), pero se
             reubica como subsección de "Contabilidad" en vez de tab propio,
             y se renombra para igualar Enterprise. Se le agrega Flotilla.
             "Préstamos" sigue sin agregarse: no existe ninguna cuenta de
             préstamos en el catálogo de ninguna de las 6 compañías y el
             modelo exige cuentas reales por compañía para crear un perfil
             (ver docs/plans/PLAN_ADAPTACION_CONTABILIDAD_COMMUNITY.md). -->
        <record id="account_asset_management.menu_finance_assets" model="ir.ui.menu" context="{'lang': 'es_MX'}">
            <field name="name">Activos y pasivos</field>
            <field name="parent_id" ref="account.menu_finance_entries"/>
            <field name="sequence">10</field>
        </record>
        <record id="account_asset_management.menu_finance_assets" model="ir.ui.menu" context="{'lang': 'en_US'}">
            <field name="name">Assets and liabilities</field>
        </record>
        <menuitem id="menu_md_fleet"
                  name="Flotilla"
                  parent="account_asset_management.menu_finance_assets"
                  action="fleet.fleet_vehicle_action"
                  sequence="20"/>

        <!-- Bloqueando (account.account_closing_menu): ya tiene "Proteger
             asientos" nativo. Se reubica ahí "Conciliar" (account_reconcile_oca
             lo deja como hermano de Transacciones/Bloqueando en vez de
             dentro de Bloqueando) y se agregan Declaración fiscal y Fechas
             de bloqueo, que no existían en ningún lado. -->
        <record id="account_reconcile_oca.account_account_reconcile_menu" model="ir.ui.menu">
            <field name="parent_id" ref="account.account_closing_menu"/>
            <field name="sequence">10</field>
        </record>
        <menuitem id="menu_md_tax_returns"
                  name="Declaración fiscal"
                  parent="account.account_closing_menu"
                  action="account_tax_balance.action_open_tax_balances"
                  sequence="20"/>
        <menuitem id="menu_md_lock_dates"
                  name="Fechas de bloqueo"
                  parent="account.account_closing_menu"
                  action="account_journal_lock_date.update_journal_lock_dates_wizard_action"
                  sequence="30"/>

        <!-- Reportes (account.menu_finance_reports): ya tiene nativos Libro
             Mayor/Diario, Balanza, Partidas Abiertas, Antigüedad, VAT e
             Informes MIS genéricos. Se agrega acceso directo al reporte de
             Balance General y P&amp;G creado en este módulo (sin esto, solo
             se llegaría a él navegando la lista genérica de MIS Reports). -->
        <menuitem id="menu_md_balance_pyg"
                  name="Balance General y P&amp;G"
                  parent="account.menu_finance_reports"
                  action="action_md_accounting_balance_pyg"
                  sequence="8"/>
    </data>
</odoo>

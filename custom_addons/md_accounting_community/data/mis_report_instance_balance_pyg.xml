<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- company_id se deja explicitamente en False: el default de
             mis.report.instance (self.env.company) se evalua UNA sola vez
             al crear el registro via XML, quedando fijo en la compania que
             estuviera activa durante la instalacion (MDS MERIDA en este
             caso) en vez de seguir la compania activa de quien lo consulta.
             Sin este eval=False explicito, with_company()/allowed_company_ids
             no tienen ningun efecto sobre el reporte. -->
        <record id="mis_report_instance_balance_pyg" model="mis.report.instance">
            <field name="name">Balance General y P&amp;G — Año actual</field>
            <field name="report_id" ref="mis_report_balance_pyg_mx"/>
            <field name="company_id" eval="False"/>
        </record>
        <record id="mis_report_instance_balance_pyg_period" model="mis.report.instance.period">
            <field name="report_instance_id" ref="mis_report_instance_balance_pyg"/>
            <field name="name">Año actual</field>
            <field name="source">actuals</field>
            <field name="mode">relative</field>
            <field name="type">y</field>
            <field name="offset">0</field>
            <field name="duration">1</field>
            <field name="sequence">10</field>
        </record>

        <record id="action_md_accounting_balance_pyg" model="ir.actions.act_window">
            <field name="name">Balance General y P&amp;G</field>
            <field name="res_model">mis.report.instance</field>
            <field name="view_mode">form</field>
            <field name="res_id" ref="mis_report_instance_balance_pyg"/>
        </record>
    </data>
</odoo>

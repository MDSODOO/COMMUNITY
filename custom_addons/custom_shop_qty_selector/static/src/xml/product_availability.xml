<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="website_sale_stock.product_availability" t-inherit-mode="extension">
        <xpath expr="//div[@id='out_of_stock_message']" position="replace">
            <div id="out_of_stock_message" class="mb-3">
                <div class="d-flex align-items-center badge text-start text-bg-danger text-wrap">
                    <i class="fa fa-circle text-danger me-2"/>
                    <span>Sin producto a la mano</span>
                </div>
            </div>
        </xpath>

        <xpath expr="//div[@id='product_stock_notification_message']" position="replace">
            <div class="btn btn-link px-0"
                 id="product_stock_notification_message">
                <i class="fa fa-envelope-o me-2"/>
                Recibe una notificación cuando vuelva a haber producto a la mano
            </div>
        </xpath>

        <xpath expr="//div[@id='stock_notification_success_message']/div" position="replace">
            <div class="py-2 small text-muted">
                <i class="fa fa-bell me-2"/>
                Te avisaremos cuando vuelva a haber producto a la mano
            </div>
        </xpath>

        <xpath expr="//div[@id='threshold_message']" position="replace">
            <div
                id="threshold_message"
                t-attf-class="availability_message_#{product_template} my-3 badge text-bg-warning d-none"
            />
        </xpath>
    </t>

</templates>

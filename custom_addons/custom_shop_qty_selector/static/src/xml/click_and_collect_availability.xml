<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <!-- website_sale_collect.ClickAndCollectAvailability es un componente OWL nativo
         de Odoo (módulo core `website_sale_collect`, Click & Collect) que muestra en
         la ficha de producto la disponibilidad por sucursal ("📍 <sucursal>") y por
         entrega ("🚚 Entrega"). Su i18n oficial (i18n/es.po) traduce "Available" como
         "Disponible" y "Not available" como "No disponible" — violación directa de la
         regla de terminología del proyecto (SIEMPRE "A la mano" para cantidad física,
         nunca "Disponible"/"Stock"/"Existencias"). No se edita el core: se hereda el
         template OWL vía t-inherit-mode="extension" y se reemplaza el div raíz completo
         con el mismo markup/lógica, solo cambiando los textos.
         Ver docs/audits/2026-07-21_shop_visual_review.md Hallazgo #2. -->
    <t t-inherit="website_sale_collect.ClickAndCollectAvailability" t-inherit-mode="extension">
        <xpath expr="//div[@class='border rounded p-3 w-100']" position="replace">
            <div class="border rounded p-3 w-100">
                <div
                    name="click_and_collect_availability"
                    t-on-click="openLocationSelector"
                    class="cursor-pointer"
                >
                    <h6>
                        <i class="fa fa-fw fa-map-marker text-muted"/>
                        <t
                            t-if="this.state.selectedLocationData.id"
                            t-out="this.state.selectedLocationData.name"
                        />
                        <t t-else="">Click and Collect</t>
                    </h6>
                    <div class="d-flex justify-content-between">
                        <t t-if="this.state.inStoreStockData?.in_stock">
                            <div
                                t-if="this.state.inStoreStockData.show_quantity &amp;&amp; this.state.selectedLocationData.id"
                                class="text-muted"
                            >
                                <i class="fa fa-fw fa-circle text-warning"/>
                                Solo <t t-out="this.state.inStoreStockData.quantity"/> a la mano
                            </div>
                            <div t-else="" class="text-muted">
                                <i class="fa fa-fw fa-circle text-success"/> A la mano
                            </div>
                        </t>
                        <div t-else="" class="text-muted">
                            <i class="fa fa-fw fa-circle text-danger"/> No hay a la mano
                        </div>
                        <a t-if="this.props.showSelectStoreButton" role="button" href="#">
                            <t t-if="this.state.selectedLocationData.id">Cambiar sucursal</t>
                            <t t-elif="this.state.inStoreStockData.in_stock">Elegir sucursal</t>
                        </a>
                    </div>
                </div>
                <div
                    name="delivery_availability"
                    t-if="Object.keys(this.state.deliveryStockData || {}).length !== 0"
                    class="flex-row"
                >
                    <hr/>
                    <h6>
                        <i class="fa fa-fw fa-truck text-muted"/>
                        Entrega
                        <i
                            class="fa fa-info-circle cursor-pointer ms-1"
                            data-tooltip="Pueden aplicar restricciones"
                            data-tooltip-delay="0"
                        />
                    </h6>
                    <div t-if="this.state.deliveryStockData.in_stock">
                        <div
                            t-if="this.state.deliveryStockData.show_quantity"
                            class="text-muted"
                        >
                            <i class="fa fa-fw fa-circle text-warning"/>
                            Solo <t t-out="this.state.deliveryStockData.quantity"/> a la mano
                        </div>
                        <div t-else="" class="text-muted">
                            <i class="fa fa-fw fa-circle text-success"/> A la mano
                        </div>
                    </div>
                    <div t-else="" class="text-muted">
                        <i class="fa fa-fw fa-circle text-danger"/> No hay a la mano
                    </div>
                </div>
            </div>
        </xpath>
    </t>

</templates>

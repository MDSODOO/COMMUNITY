<odoo>
    <record id="view_hr_attendance_geofence_list" model="ir.ui.view">
        <field name="name">hr.attendance.geofence.list</field>
        <field name="model">hr.attendance.geofence</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id"/>
                <field name="center_latitude"/>
                <field name="center_longitude"/>
                <field name="radius_meters"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_hr_attendance_geofence_form" model="ir.ui.view">
        <field name="name">hr.attendance.geofence.form</field>
        <field name="model">hr.attendance.geofence</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id"/>
                        <field name="center_latitude"/>
                        <field name="center_longitude"/>
                        <field name="radius_meters"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_attendance_geofence" model="ir.actions.act_window">
        <field name="name">Geocercas de asistencia</field>
        <field name="res_model">hr.attendance.geofence</field>
        <field name="view_mode">list,form</field>
        <field name="help">
            Geocercas de respaldo: solo se evalúan cuando el check-in con
            huella no proviene de una IP autorizada de la sucursal (personal
            de campo / remoto).
        </field>
    </record>
</odoo>

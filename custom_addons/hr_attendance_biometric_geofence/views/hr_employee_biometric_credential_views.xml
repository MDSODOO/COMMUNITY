<odoo>
    <record id="view_hr_employee_biometric_credential_list" model="ir.ui.view">
        <field name="name">hr.employee.biometric.credential.list</field>
        <field name="model">hr.employee.biometric.credential</field>
        <field name="arch" type="xml">
            <list>
                <field name="employee_id"/>
                <field name="name"/>
                <field name="algorithm"/>
                <field name="sign_count"/>
                <field name="last_used"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_hr_attendance_biometric_credential" model="ir.actions.act_window">
        <field name="name">Credenciales biométricas registradas</field>
        <field name="res_model">hr.employee.biometric.credential</field>
        <field name="view_mode">list</field>
        <field name="help">
            Solo administra el par credential_id/clave pública WebAuthn --
            aquí nunca se almacena la huella ni su plantilla biométrica.
        </field>
    </record>
</odoo>

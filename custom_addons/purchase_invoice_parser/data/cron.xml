<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="ir_cron_cleanup_price_notifications" model="ir.cron">
            <field name="name">Limpiar notificaciones de precio antiguas</field>
            <field name="model_id" ref="model_purchase_price_notification"/>
            <field name="state">code</field>
            <field name="code">model._cron_cleanup_old_notifications()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">1</field>
            <field name="nextcall" eval="(DateTime.now().replace(hour=0, minute=0, second=0) + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        </record>

    </data>
</odoo>

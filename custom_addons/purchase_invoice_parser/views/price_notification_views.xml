<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================================================================== -->
    <!-- VISTA DE LISTA (TREE) — Notificaciones de Precio                     -->
    <!-- ===================================================================== -->
    <record id="view_purchase_price_notification_tree" model="ir.ui.view">
        <field name="name">purchase.price.notification.tree</field>
        <field name="model">purchase.price.notification</field>
        <field name="arch" type="xml">
            <list string="Notificaciones de Precio" decoration-success="state == 'applied'" decoration-info="state == 'read'" decoration-warning="state == 'unread'">
                <field name="create_date" string="Fecha"/>
                <field name="product_name" string="Producto"/>
                <field name="partner_name" string="Proveedor"/>
                <field name="old_price" string="Precio Anterior" widget="monetary"/>
                <field name="new_price" string="Precio Nuevo" widget="monetary"/>
                <field name="currency_id" string="Moneda" optional="hide"/>
                <field name="purchase_order_id" string="Orden de Compra" optional="hide"/>
                <field name="company_id" string="Compañía" optional="hide"/>
                <field name="state" string="Estado" widget="badge" decoration-success="state == 'applied'" decoration-info="state == 'read'" decoration-warning="state == 'unread'"/>
            </list>
        </field>
    </record>

    <!-- ===================================================================== -->
    <!-- VISTA DE FORMULARIO — Detalles de Notificación                       -->
    <!-- ===================================================================== -->
    <record id="view_purchase_price_notification_form" model="ir.ui.view">
        <field name="name">purchase.price.notification.form</field>
        <field name="model">purchase.price.notification</field>
        <field name="arch" type="xml">
            <form string="Notificación de Precio">
                <header>
                    <button string="Aplicar Precio"
                            name="action_apply_price_change"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'unread'"
                            icon="fa-check-circle"/>
                    <button string="Marcar como Leída"
                            name="action_mark_as_read_or_delete"
                            type="object"
                            class="btn-secondary"
                            invisible="state != 'unread'"
                            icon="fa-check"/>
                    <button string="Eliminar"
                            name="action_mark_as_read_or_delete"
                            type="object"
                            class="btn-danger"
                            invisible="state == 'unread'"
                            icon="fa-trash"/>
                    <field name="state" widget="statusbar" readonly="1"/>
                </header>
                <sheet>
                    <group>
                        <group string="Producto">
                            <field name="product_tmpl_id" readonly="1"/>
                            <field name="product_id" readonly="1" optional="hide"/>
                            <field name="product_name" readonly="1"/>
                        </group>
                        <group string="Proveedor">
                            <field name="partner_id" readonly="1"/>
                            <field name="partner_name" readonly="1" optional="hide"/>
                        </group>
                    </group>
                    <group>
                        <group string="Precios">
                            <field name="old_price" readonly="1"/>
                            <field name="new_price" readonly="1"/>
                            <field name="currency_id" readonly="1"/>
                        </group>
                        <group string="Información">
                            <field name="purchase_order_id" readonly="1"/>
                            <field name="company_id" readonly="1"/>
                            <field name="create_date" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ===================================================================== -->
    <!-- VISTA DE BÚSQUEDA — Filtros y búsqueda                               -->
    <!-- ===================================================================== -->
    <record id="view_purchase_price_notification_search" model="ir.ui.view">
        <field name="name">purchase.price.notification.search</field>
        <field name="model">purchase.price.notification</field>
        <field name="arch" type="xml">
            <search string="Buscar Notificación">
                <field name="product_name" string="Producto"/>
                <field name="partner_id" string="Proveedor"/>
                <field name="purchase_order_id" string="Orden de Compra"/>
                <filter name="filter_unread" string="Sin Leer" domain="[('state', '=', 'unread')]"/>
                <filter name="filter_read" string="Leídas" domain="[('state', '=', 'read')]"/>
                <filter name="filter_applied" string="Aplicadas" domain="[('state', '=', 'applied')]"/>
                <separator/>
                <filter name="filter_archived" string="Archivadas" domain="[('active', '=', False)]"/>
                <separator string="Agrupar por"/>
                <filter name="group_by_partner" string="Proveedor" context="{'group_by': 'partner_id'}"/>
                <filter name="group_by_product" string="Producto" context="{'group_by': 'product_tmpl_id'}"/>
                <filter name="group_by_state" string="Estado" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <!-- ===================================================================== -->
    <!-- VISTA DE GRÁFICO (PIVOT) — Dashboard de Cambios                     -->
    <!-- ===================================================================== -->
    <record id="view_purchase_price_notification_pivot" model="ir.ui.view">
        <field name="name">purchase.price.notification.pivot</field>
        <field name="model">purchase.price.notification</field>
        <field name="arch" type="xml">
            <pivot string="Análisis de Precios" default_order="create_date desc">
                <field name="partner_id" type="row"/>
                <field name="product_tmpl_id" type="row"/>
                <field name="state" type="col"/>
                <field name="new_price" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- ===================================================================== -->
    <!-- VISTA DE GRÁFICO (GRAPH) — Cambios de Precio por Proveedor          -->
    <!-- ===================================================================== -->
    <record id="view_purchase_price_notification_graph" model="ir.ui.view">
        <field name="name">purchase.price.notification.graph</field>
        <field name="model">purchase.price.notification</field>
        <field name="arch" type="xml">
            <graph string="Cambios de Precio por Proveedor" type="bar">
                <field name="partner_id" type="row"/>
                <field name="new_price" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ===================================================================== -->
    <!-- SERVER ACTION: Exportar a Excel                                      -->
    <!-- Aparece en menú Acción de la lista de notificaciones.               -->
    <!-- ===================================================================== -->
    <record id="action_export_price_change_excel" model="ir.actions.server">
        <field name="name">Exportar a Excel</field>
        <field name="model_id" ref="model_purchase_price_notification"/>
        <field name="binding_model_id" ref="model_purchase_price_notification"/>
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">action = records.action_export_price_change_excel()</field>
    </record>

    <!-- ===================================================================== -->
    <!-- ACCIÓN: Notificaciones de Precio (Lista)                             -->
    <!-- ===================================================================== -->
    <record id="action_purchase_price_notifications" model="ir.actions.act_window">
        <field name="name">Notificaciones de Precio</field>
        <field name="res_model">purchase.price.notification</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="search_view_id" ref="view_purchase_price_notification_search"/>
        <field name="context">{
            'active_test': False,
            'pivot_row_groupby': ['partner_id'],
            'pivot_column_groupby': ['state'],
            'pivot_measures': ['new_price'],
        }</field>
        <field name="domain">[('company_id', 'in', allowed_company_ids)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay notificaciones de precio.
            </p>
            <p>
                Las notificaciones se generan automáticamente cuando importas facturas CFDI
                y detecta cambios en los precios de los proveedores.
            </p>
        </field>
    </record>

</odoo>

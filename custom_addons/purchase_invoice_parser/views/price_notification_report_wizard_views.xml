<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_price_notification_report_wizard_form" model="ir.ui.view">
        <field name="name">purchase.price.notification.report.wizard.form</field>
        <field name="model">purchase.price.notification.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Reporte de Cambios de Precio">
                <group>
                    <group string="Filtros">
                        <field name="line_ids" widget="many2many_tags"
                               string="Línea de Producto"
                               placeholder="Vacío = todas las líneas"/>
                        <field name="company_ids" widget="many2many_tags"
                               string="Sucursales"/>
                        <field name="state" string="Estado"/>
                    </group>
                </group>
                <footer>
                    <button string="Generar PDF"
                            name="action_print_report"
                            type="object"
                            class="btn-primary"
                            icon="fa-file-pdf-o"/>
                    <button string="Exportar Excel"
                            name="action_export_excel"
                            type="object"
                            class="btn-secondary"
                            icon="fa-file-excel-o"/>
                    <button string="Cancelar"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_price_notification_report_wizard" model="ir.actions.act_window">
        <field name="name">Reporte de Cambios de Precio</field>
        <field name="res_model">purchase.price.notification.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>

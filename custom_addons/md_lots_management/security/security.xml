<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record model="ir.module.category" id="module_category_lots_management">
            <field name="name">Gestión de Lotes</field>
            <field name="sequence">50</field>
        </record>

        <record model="res.groups.privilege" id="privilege_lots_company_manager">
            <field name="name">Gestión Multiempresa de Lotes</field>
            <field name="category_id" ref="module_category_lots_management"/>
        </record>

        <record id="group_lots_company_manager" model="res.groups">
            <field name="name">Gestión Multiempresa de Lotes</field>
            <field name="privilege_id" ref="privilege_lots_company_manager"/>
        </record>

        <record model="res.groups.privilege" id="privilege_lots_handheld_user">
            <field name="name">Acceso a Consulta Handheld</field>
            <field name="category_id" ref="module_category_lots_management"/>
        </record>

        <record id="group_lots_handheld_user" model="res.groups">
            <field name="name">Consulta Handheld</field>
            <field name="privilege_id" ref="privilege_lots_handheld_user"/>
        </record>

        <!-- Los administradores del sistema conservan acceso a Consulta Handheld
             para soporte, sin necesidad de asignación manual del grupo. -->
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_lots_handheld_user'))]"/>
        </record>
    </data>
</odoo>

<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Vista Kanban: Consulta Handheld (móvil/CT58) -->
        <record id="view_production_lot_kanban_handheld" model="ir.ui.view">
            <field name="name">Lotes - Kanban Handheld</field>
            <field name="model">stock.lot</field>
            <field name="type">kanban</field>
            <field name="arch" type="xml">
                <kanban js_class="md_handheld_kanban" class="o_md_handheld_kanban" records_draggable="false" create="false" group_create="false" group_edit="false" group_delete="false" archivable="false">
                    <field name="name"/>
                    <field name="product_id"/>
                    <field name="product_barcode"/>
                    <field name="public_sale_price"/>
                    <field name="public_sale_price_total"/>
                    <field name="has_public_sale_tax"/>
                    <field name="public_sale_price_tax_label"/>
                    <field name="expiration_date"/>
                    <field name="qty_a_la_mano"/>
                    <field name="md_expiry_color"/>
                    <field name="md_is_short_expiry"/>
                    <templates>
                        <t t-name="card">
                            <!-- Sin oe_kanban_global_click: es tarjeta de solo consulta, no navega al formulario.
                                 user-select/touch-callout en none: evita que un toque largo dispare el menú nativo
                                 de selección de texto del dispositivo (se confundía con "seleccionar el registro").
                                 Clases o_md_handheld_*: reskin bento/glass consistente con el resto de la UI
                                 (portal + carrito), estilos en handheld_kanban.scss consumiendo las custom
                                 properties de marca (prefijo md) ya definidas por
                                 medicine_depot_portal/backend_tokens.scss.

                                 Anillo "Prox. Vencer" (md-short-expiry-ring/-pill) y color de
                                 vencimiento (md_expiry_color): mismo lenguaje visual aplicado en
                                 md_pharma_regulatory al Kanban de Inventario > Productos, validado
                                 contra bi_pos_stock/pos_product_card.scss. Aqui es MAS directo que
                                 en Productos porque este registro YA es un lote especifico (no un
                                 agregado por producto). -->
                            <div class="o_md_handheld_card p-3" style="user-select: none; -webkit-user-select: none; -webkit-touch-callout: none;">
                                <div t-if="record.md_is_short_expiry.raw_value" class="md-short-expiry-ring" aria-label="Próximo a vencer" aria-hidden="true">
                                    <span class="md-short-expiry-pill">Prox. Vencer</span>
                                </div>
                                <!-- Fila 1: Producto + Precio / Row 1: Product + Price -->
                                <div class="d-flex justify-content-between align-items-start">
                                    <strong class="o_md_handheld_product me-2"><field name="product_id"/></strong>
                                    <span class="o_md_handheld_price text-end flex-shrink-0">
                                        <span class="o_md_handheld_price_label d-block">Precio de venta</span>
                                        <span class="o_md_handheld_price_value d-block">$<field name="public_sale_price"/></span>
                                        <span t-if="record.has_public_sale_tax.raw_value" class="o_md_handheld_price_tax d-block">
                                            + <field name="public_sale_price_tax_label"/> = $<field name="public_sale_price_total"/>
                                        </span>
                                    </span>
                                </div>
                                <!-- Fila 2: Lote + Vencimiento / Row 2: Lot + Expiration -->
                                <div class="o_md_handheld_meta d-flex justify-content-between mt-1">
                                    <span>Lote: <field name="name"/></span>
                                    <span t-attf-class="o_md_handheld_expiry o_md_handheld_expiry--{{record.md_expiry_color.value}}">
                                        Vence: <field name="expiration_date"/>
                                    </span>
                                </div>
                                <!-- Imagen del código de barras del PRODUCTO (record.product_barcode,
                                     related a product_id.barcode) = valor escaneable fisico real
                                     de la etiqueta/empaque. NO usar record.name: ese es el numero
                                     de LOTE, no el codigo de barras del producto. Usa /report/barcode/
                                     nativo de Odoo (auth='public', reportlab), no un widget de captura.
                                     t-if oculta la imagen si el producto no tiene barcode cargado,
                                     para no romper el render con una URL vacia.
                                     img-fluid + max-width/height: legible y no desborda en
                                     pantallas pequenas de handheld (CT58 y similares). -->
                                <div t-if="record.product_barcode.raw_value" class="o_md_handheld_barcode text-center mt-2">
                                    <img t-attf-src="/report/barcode/Code128/{{record.product_barcode.raw_value}}?width=300&amp;height=60&amp;humanreadable=1"
                                         class="img-fluid"
                                         style="max-width: 100%; height: 60px;"
                                         alt="Código de barras del producto"/>
                                </div>
                                <!-- Fila 3: Cantidad A la mano / Row 3: On Hand quantity -->
                                <div class="mt-2">
                                    <span class="o_md_handheld_badge"
                                          t-attf-class="{{record.qty_a_la_mano.raw_value &gt; 0 ? 'o_md_handheld_badge--ok' : 'o_md_handheld_badge--low'}}">
                                        A la mano: <field name="qty_a_la_mano"/>
                                    </span>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Vista de Búsqueda: optimizada para escáner de código de barras -->
        <record id="view_production_lot_search_handheld" model="ir.ui.view">
            <field name="name">Lotes - Búsqueda Handheld</field>
            <field name="model">stock.lot</field>
            <field name="type">search</field>
            <field name="arch" type="xml">
                <search string="Consulta Handheld">
                    <field name="name" string="Lote / Código de Barras"
                           filter_domain="['|', ('name', 'ilike', self), ('product_id.barcode', '=', self)]"/>
                    <filter name="on_hand_handheld" string="A la mano"
                            domain="[('qty_a_la_mano', '&gt;', 0)]"/>
                </search>
            </field>
        </record>

        <!-- Acción: Consulta Handheld -->
        <record id="action_production_lot_handheld" model="ir.actions.act_window">
            <field name="name">Consulta Handheld</field>
            <field name="res_model">stock.lot</field>
            <!-- Solo kanban: no se debe poder entrar a la ficha del lote desde aquí -->
            <field name="view_mode">kanban</field>
            <field name="search_view_id" ref="view_production_lot_search_handheld"/>
            <!-- Vista de solo consulta: el operador no debe crear, editar, eliminar
                 ni duplicar lotes desde aquí (riesgo de alterar registros por error). -->
            <field name="context">{
                'search_default_on_hand_handheld': 1,
                'create': False,
                'edit': False,
                'delete': False,
                'duplicate': False,
            }</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No hay lotes con existencia A la mano.
                </p>
            </field>
        </record>

        <record id="action_production_lot_handheld_view_kanban" model="ir.actions.act_window.view">
            <field name="sequence" eval="1"/>
            <field name="view_mode">kanban</field>
            <field name="view_id" ref="view_production_lot_kanban_handheld"/>
            <field name="act_window_id" ref="action_production_lot_handheld"/>
        </record>

        <!-- Menú: Consulta Handheld -->
        <menuitem
            id="menu_production_lot_handheld"
            parent="stock.menu_stock_root"
            name="Consulta Handheld"
            action="action_production_lot_handheld"
            groups="md_lots_management.group_lots_handheld_user"
            sequence="11"
        />
    </data>
</odoo>

<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_account_form_inherit_l10n_mx_sat" model="ir.ui.view">
            <field name="name">account.account.form.inherit.l10n.mx.sat</field>
            <field name="model">account.account</field>
            <field name="inherit_id" ref="account.view_account_form"/>
            <field name="arch" type="xml">
                <field name="account_type" position="after">
                    <field name="l10n_mx_sat_group_code_id"/>
                </field>
            </field>
        </record>

        <record id="view_account_list_inherit_l10n_mx_sat" model="ir.ui.view">
            <field name="name">account.account.list.inherit.l10n.mx.sat</field>
            <field name="model">account.account</field>
            <field name="inherit_id" ref="account.view_account_list"/>
            <field name="arch" type="xml">
                <field name="account_type" position="after">
                    <field name="l10n_mx_sat_group_code_id" optional="hide"/>
                </field>
            </field>
        </record>
    </data>
</odoo>

<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_l10n_mx_sat_balanza_wizard_form" model="ir.ui.view">
            <field name="name">l10n_mx.sat.balanza.wizard.form</field>
            <field name="model">l10n_mx.sat.balanza.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <field name="company_id"/>
                    <field name="month"/>
                    <field name="year"/>
                    <footer>
                        <button name="action_generate_xml" string="Generar XML"
                                type="object" class="btn-primary"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_l10n_mx_sat_balanza_wizard" model="ir.actions.act_window">
            <field name="name">Balanza de Comprobación (XML SAT)</field>
            <field name="res_model">l10n_mx.sat.balanza.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem id="menu_l10n_mx_sat_balanza_wizard"
                  name="Balanza de Comprobación (XML SAT)"
                  parent="account.menu_finance_reports"
                  action="action_l10n_mx_sat_balanza_wizard"
                  sequence="10"/>
    </data>
</odoo>

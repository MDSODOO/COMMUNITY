    <template id="pharma_invoice_sat_footer">
        <!--
          Complemento CFDI 4.0 — paleta pharma (navy #234759, cyan #3aa5c9).
          Diseño inspirado en guía visual, adaptado a tabla HTML pura para
          compatibilidad con wkhtmltopdf (sin CSS grid ni flex).
          Solo se muestra cuando la factura está timbrada (tiene UUID).
        -->
        <t t-set="_cfdi_uuid" t-value="md_cfdi.get('uuid') or (o.l10n_mx_edi_cfdi_uuid if o and 'l10n_mx_edi_cfdi_uuid' in o._fields else '') or ''"/>
        <table class="inv-sat-footer inv-sat-table"
               width="100%"
               style="width:100% !important; font-size:8px; page-break-inside:avoid; table-layout:fixed; border-collapse:collapse; margin-top:16px; border:1px solid #e2e8f0;"
               t-if="_cfdi_uuid">
            <colgroup>
                <col style="width:22%;"/>
                <col style="width:78%;"/>
            </colgroup>

            <!-- ── TÍTULO ─────────────────────────────────────────── -->
            <tr>
                <td colspan="2" class="inv-sat-title"
                    style="background-color:#234759 !important; color:#ffffff !important; font-size:9pt; font-weight:700; letter-spacing:0.5px; text-transform:uppercase; padding:8px 12px; -webkit-print-color-adjust:exact; print-color-adjust:exact;">
                    Complemento Fiscal CFDI 4.0
                </td>
            </tr>

            <!-- ── QR (22%) | METADATOS (78%) ─────────────────────── -->
            <tr>
                <td class="inv-sat-qr"
                    style="width:22%; vertical-align:middle; text-align:center; padding:12px 8px; background-color:#f8fafc !important; border-right:1px solid #e2e8f0; -webkit-print-color-adjust:exact; print-color-adjust:exact;">
                    <t t-if="md_cfdi.get('qr_url')">
                        <div style="border:1px solid #e2e8f0; background-color:#ffffff !important; padding:4px; display:inline-block; -webkit-print-color-adjust:exact; print-color-adjust:exact;">
                            <img class="inv-cfdi-qr-img"
                                 style="display:block; width:100%; max-width:105px; height:auto;"
                                 t-att-src="md_cfdi.get('qr_url')"
                                 alt="QR CFDI"/>
                        </div>
                    </t>
                    <div style="color:#475569; font-size:6pt; font-weight:600; line-height:1.3; text-transform:uppercase; letter-spacing:0.3px; margin-top:6px;">
                        Código de<br/>verificación
                    </div>
                </td>

                <td class="inv-sat-meta"
                    style="width:78%; vertical-align:top; padding:10px 12px;">

                    <!-- Folio Fiscal (UUID) -->
                    <div style="border-left:3px solid #3aa5c9; background-color:#f1f5f9 !important; padding:5px 8px; margin-bottom:8px; -webkit-print-color-adjust:exact; print-color-adjust:exact;">
                        <strong style="display:block; color:#3aa5c9; font-size:6pt; font-weight:700; text-transform:uppercase; letter-spacing:0.3px; margin-bottom:2px;">Folio Fiscal (UUID)</strong>
                        <span style="font-family:'Courier New',monospace; font-size:8.5pt; font-weight:700; color:#0f172a; word-break:break-all; overflow-wrap:break-word;"
                              t-esc="_cfdi_uuid"/>
                    </div>

                    <!-- Grid 2×2: fecha/RFC · certSAT/certEmisor -->
                    <table width="100%" style="table-layout:fixed; border-collapse:separate; border-spacing:4px 4px; width:100%; margin:0;">
                        <colgroup>
                            <col style="width:50%;"/>
                            <col style="width:50%;"/>
                        </colgroup>
                        <tr>
                            <td style="vertical-align:top; padding:5px 8px; background-color:#f8fafc !important; border-left:3px solid #3aa5c9; -webkit-print-color-adjust:exact; print-color-adjust:exact;">
                                <strong style="display:block; color:#3aa5c9; font-size:6pt; font-weight:700; text-transform:uppercase; letter-spacing:0.3px; margin-bottom:2px;">Fecha y hora de certificación</strong>
                                <span style="color:#0f172a; font-size:7pt; font-weight:600;"
                                      t-esc="md_cfdi.get('fecha_timbrado') or '—'"/>
                            </td>
                            <td style="vertical-align:top; padding:5px 8px; background-color:#f8fafc !important; border-left:3px solid #3aa5c9; -webkit-print-color-adjust:exact; print-color-adjust:exact;">
                                <strong style="display:block; color:#3aa5c9; font-size:6pt; font-weight:700; text-transform:uppercase; letter-spacing:0.3px; margin-bottom:2px;">RFC Prov. Certif.</strong>
                                <span style="color:#0f172a; font-size:7pt; font-weight:600; word-break:break-all;"
                                      t-esc="md_cfdi.get('rfc_prov_certif') or '—'"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="vertical-align:top; padding:5px 8px; background-color:#f8fafc !important; border-left:3px solid #3aa5c9; -webkit-print-color-adjust:exact; print-color-adjust:exact;">
                                <strong style="display:block; color:#3aa5c9; font-size:6pt; font-weight:700; text-transform:uppercase; letter-spacing:0.3px; margin-bottom:2px;">No. Certificado SAT</strong>
                                <span style="color:#0f172a; font-size:7pt; font-weight:600; font-family:'Courier New',monospace; word-break:break-all;"
                                      t-esc="md_cfdi.get('no_certificado_sat') or '—'"/>
                            </td>
                            <td style="vertical-align:top; padding:5px 8px; background-color:#f8fafc !important; border-left:3px solid #3aa5c9; -webkit-print-color-adjust:exact; print-color-adjust:exact;">
                                <strong style="display:block; color:#3aa5c9; font-size:6pt; font-weight:700; text-transform:uppercase; letter-spacing:0.3px; margin-bottom:2px;">No. Certificado Emisor</strong>
                                <span style="color:#0f172a; font-size:7pt; font-weight:600; font-family:'Courier New',monospace; word-break:break-all;"
                                      t-esc="md_cfdi.get('no_certificado') or '—'"/>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>

            <!-- ── SELLO CFDI ──────────────────────────────────────── -->
            <tr>
                <td colspan="2"
                    style="background-color:#eef2f5 !important; color:#234759; font-size:6.5pt; font-weight:700; text-transform:uppercase; letter-spacing:0.3px; padding:4px 12px; border-top:1px solid #e2e8f0; border-left:3px solid #3aa5c9; -webkit-print-color-adjust:exact; print-color-adjust:exact;">
                    Sello Digital del CFDI (Emisor)
                </td>
            </tr>
            <tr>
                <td colspan="2" style="padding:6px 12px 8px; background-color:#ffffff !important; -webkit-print-color-adjust:exact; print-color-adjust:exact;">
                    <span style="display:block; font-family:'Courier New',monospace; font-size:6.5pt; color:#1e293b; line-height:1.35; word-break:break-all; overflow-wrap:break-word; white-space:normal;"
                          t-esc="md_cfdi.get('sello_cfdi') or '—'"/>
                </td>
            </tr>

            <!-- ── SELLO SAT ───────────────────────────────────────── -->
            <tr>
                <td colspan="2"
                    style="background-color:#eef2f5 !important; color:#234759; font-size:6.5pt; font-weight:700; text-transform:uppercase; letter-spacing:0.3px; padding:4px 12px; border-top:1px solid #e2e8f0; border-left:3px solid #3aa5c9; -webkit-print-color-adjust:exact; print-color-adjust:exact;">
                    Sello Digital del SAT
                </td>
            </tr>
            <tr>
                <td colspan="2" style="padding:6px 12px 8px; background-color:#ffffff !important; -webkit-print-color-adjust:exact; print-color-adjust:exact;">
                    <span style="display:block; font-family:'Courier New',monospace; font-size:6.5pt; color:#1e293b; line-height:1.35; word-break:break-all; overflow-wrap:break-word; white-space:normal;"
                          t-esc="md_cfdi.get('sello_sat') or '—'"/>
                </td>
            </tr>

            <!-- ── CADENA ORIGINAL ─────────────────────────────────── -->
            <tr>
                <td colspan="2"
                    style="background-color:#eef2f5 !important; color:#234759; font-size:6.5pt; font-weight:700; text-transform:uppercase; letter-spacing:0.3px; padding:4px 12px; border-top:1px solid #e2e8f0; border-left:3px solid #3aa5c9; -webkit-print-color-adjust:exact; print-color-adjust:exact;">
                    Cadena Original del Complemento de Certificación Digital del SAT
                </td>
            </tr>
            <tr>
                <td colspan="2" style="padding:6px 12px 8px; background-color:#ffffff !important; -webkit-print-color-adjust:exact; print-color-adjust:exact;">
                    <span style="display:block; font-family:'Courier New',monospace; font-size:6.5pt; color:#1e293b; line-height:1.35; word-break:break-all; overflow-wrap:break-word; white-space:normal;"
                          t-esc="md_cfdi.get('cadena_original') or '—'"/>
                </td>
            </tr>

        </table>
    </template>

    <!-- ═══════════════════════════════════════════════════════════════
         Variante del address-block para account.move (el partial de
         sale_lot_report sólo acepta sale.order/stock.picking/purchase.order).
         Añade Régimen fiscal del receptor (requerimiento CFDI 4.0).
    ════════════════════════════════════════════════════════════════════ -->
    <!-- ════════════════════════════════════════════════════════════════
         SUB-TEMPLATE: Lotes farmacéuticos inline en línea de Factura / Nota de Crédito.
         Aislado para que sea testeable y reutilizable sin duplicar la lógica en el xpath.

         Variables requeridas (deben setearse antes del t-call):
           line_lots — lista de dicts: [{lot_name: str, expiration_date: str}, ...]
                       producida por md_get_invoice_line_lot_values()[line.id]
                       puede ser [] para líneas sin lote (el sub-template no renderiza nada)

         Salida: div.inv-line-lots con un div.pharma-lot-inline por cada lote.
         Estilos: inv-line-lots (report_invoice.css) + pharma-lot-inline (pharma_report.scss)
    ════════════════════════════════════════════════════════════════════ -->
    <template id="pharma_invoice_lot_block">
        <div t-if="line_lots" class="inv-line-lots">
            <t t-foreach="line_lots" t-as="lot_info">
                <div class="pharma-lot-inline">
                    <span>Lote: <strong t-esc="lot_info.get('lot_name') or '—'"/></span>
                    <t t-if="lot_info.get('expiration_date')">
                        <span> | Caducidad: <strong t-esc="lot_info.get('expiration_date')"/></span>
                    </t>
                </div>
            </t>
        </div>
    </template>

    <template id="pharma_invoice_address_block">
        <t t-set="_addr_partner" t-value="pharma_doc.partner_id"/>
        <t t-set="_is_in" t-value="pharma_doc.move_type in ('in_invoice', 'in_refund', 'in_receipt')"/>
        <t t-set="_partner_label" t-value="'Proveedor' if _is_in else 'Cliente'"/>
        <div class="pharma-doc pharma-addr-grid" style="font-size: 0.9rem;">
            <div class="row g-0">
                <div class="col-6 pe-4 pharma-addr-col">
                    <span class="pharma-addr-label" style="font-size: 0.85rem; font-weight: 600;">Sucursal</span>
                    <div class="pharma-addr-name">
                        <span t-field="pharma_company.partner_id.name"/>
                    </div>
                    <div class="pharma-addr-lines"
                         t-field="pharma_company.partner_id"
                         t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}'/>
                    <span class="pharma-addr-rfc">
                        RFC: <span t-esc="pharma_company.vat or pharma_company.partner_id.vat or '—'"/>
                    </span>
                </div>
                <div class="col-6 ps-4 pharma-addr-col pharma-addr-divider">
                    <span class="pharma-addr-label" t-esc="_partner_label"/>
                    <div class="pharma-addr-name">
                        <span t-esc="_addr_partner.name if _addr_partner else '—'"/>
                    </div>
                    <div t-if="_addr_partner"
                         class="pharma-addr-lines"
                         t-field="pharma_doc.partner_id"
                         t-options='{"widget": "contact", "fields": ["address"], "no_marker": True}'/>
                    <span class="pharma-addr-rfc">
                        RFC: <span t-esc="_addr_partner.vat if _addr_partner and _addr_partner.vat else '—'"/>
                    </span>
                    <t t-if="_addr_partner and 'l10n_mx_edi_fiscal_regime' in _addr_partner._fields and _addr_partner.l10n_mx_edi_fiscal_regime">
                        <span class="pharma-addr-rfc inv-addr-regime">
                            Régimen: <span t-field="_addr_partner.l10n_mx_edi_fiscal_regime"/>
                        </span>
                    </t>
                </div>
            </div>
        </div>
    </template>


<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit product.template form to add discount restriction info -->
    <record id="product_template_form_inherit_discount_policy" model="ir.ui.view">
        <field name="name">product.template form inherit discount_policy</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_tag_ids']" position="after">
                <field name="is_discount_restricted"/>
            </xpath>
        </field>
    </record>
</odoo>

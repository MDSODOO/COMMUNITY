<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Wizard form for importing restricted product SKUs -->
    <record id="restricted_product_import_form" model="ir.ui.view">
        <field name="name">restricted.product.import form</field>
        <field name="model">restricted.product.import</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="csv_file" filename="csv_filename"/>
                    <field name="csv_filename" invisible="1"/>
                </group>
                <group>
                    <field name="import_log" nolabel="1"/>
                </group>
                <footer>
                    <button name="action_import" type="object" string="Import" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Wizard action -->
    <record id="action_restricted_product_import" model="ir.actions.act_window">
        <field name="name">Import Restricted SKUs</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">restricted.product.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menu item in Settings > Sales -->
    <menuitem
        id="menu_restricted_product_import"
        name="Import Restricted SKUs"
        parent="sale.menu_sale_config"
        action="action_restricted_product_import"
        sequence="20"/>
</odoo>

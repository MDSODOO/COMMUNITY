<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_pos_payment_rectifier_wizard_form" model="ir.ui.view">
            <field name="name">pos.payment.rectifier.wizard.form</field>
            <field name="model">pos.payment.rectifier.wizard</field>
            <field name="arch" type="xml">
                <form string="Rectificar Método de Pago">
                    <field name="company_id" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <group>
                        <field name="order_id" readonly="1"/>
                        <field name="wrong_payment_id"/>
                        <field name="old_payment_method_id" readonly="1"/>
                        <field name="amount" readonly="1"/>
                    </group>
                    <group>
                        <field name="new_payment_method_id"/>
                        <field name="journal_id"/>
                        <field name="reason" placeholder="Ej: Cajero capturó Tarjeta de Débito por error, cliente pagó en Efectivo — confirmado con arqueo de caja del turno."/>
                    </group>
                    <footer>
                        <button name="action_confirm" type="object" string="Rectificar" class="btn-primary"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>

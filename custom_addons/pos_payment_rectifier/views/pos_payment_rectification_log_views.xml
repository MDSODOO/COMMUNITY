<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_pos_payment_rectification_log_list" model="ir.ui.view">
            <field name="name">pos.payment.rectification.log.list</field>
            <field name="model">pos.payment.rectification.log</field>
            <field name="arch" type="xml">
                <list string="Rectificaciones de Pago PoS" create="0" edit="0" delete="0">
                    <field name="create_date" string="Fecha"/>
                    <field name="order_id"/>
                    <field name="session_id"/>
                    <field name="old_payment_method_id"/>
                    <field name="new_payment_method_id"/>
                    <field name="amount"/>
                    <field name="state" decoration-warning="state == 'needs_review'"/>
                    <field name="create_uid" string="Rectificado por"/>
                </list>
            </field>
        </record>

        <record id="view_pos_payment_rectification_log_form" model="ir.ui.view">
            <field name="name">pos.payment.rectification.log.form</field>
            <field name="model">pos.payment.rectification.log</field>
            <field name="arch" type="xml">
                <form string="Rectificación de Pago PoS" create="0" edit="0" delete="0">
                    <sheet>
                        <group>
                            <field name="order_id"/>
                            <field name="session_id"/>
                            <field name="old_payment_method_id"/>
                            <field name="new_payment_method_id"/>
                            <field name="amount"/>
                            <field name="reclass_move_id"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="reason"/>
                            <field name="review_note" invisible="state != 'needs_review'"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_pos_payment_rectification_log" model="ir.actions.act_window">
            <field name="name">Rectificaciones de Pago PoS</field>
            <field name="res_model">pos.payment.rectification.log</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_pos_payment_rectification_log"
                  name="Rectificaciones de Pago"
                  parent="point_of_sale.menu_point_of_sale"
                  action="action_pos_payment_rectification_log"
                  groups="pos_payment_rectifier.group_pos_rectification_manager"
                  sequence="80"/>
    </data>
</odoo>

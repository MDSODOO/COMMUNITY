<odoo>
    <record id="view_company_form_cfdi" model="ir.ui.view">
        <field name="name">res.company.form.cfdi</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="CFDI / SAT (México)">
                    <group string="Datos fiscales">
                        <field name="l10n_mx_regimen_fiscal"/>
                    </group>
                    <group string="CSD (Certificado de Sello Digital)">
                        <field name="l10n_mx_csd_certificate" filename="l10n_mx_csd_certificate_filename"/>
                        <field name="l10n_mx_csd_certificate_filename" invisible="1"/>
                        <field name="l10n_mx_csd_key" filename="l10n_mx_csd_key_filename"/>
                        <field name="l10n_mx_csd_key_filename" invisible="1"/>
                        <field name="l10n_mx_csd_password" password="True"/>
                    </group>
                    <group string="PAC (timbrado)">
                        <field name="l10n_mx_pac_test_mode"/>
                        <field name="l10n_mx_pac_username"/>
                        <field name="l10n_mx_pac_password" password="True"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>

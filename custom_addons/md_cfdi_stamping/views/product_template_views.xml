<odoo>
    <record id="view_product_template_form_cfdi" model="ir.ui.view">
        <field name="name">product.template.form.cfdi</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="l10n_mx_clave_prod_serv"/>
                <field name="l10n_mx_clave_unidad"/>
            </xpath>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_image_quote_request_list" model="ir.ui.view">
        <field name="name">local.ai.image.quote.request.list</field>
        <field name="model">local.ai.image.quote.request</field>
        <field name="arch" type="xml">
            <list decoration-warning="state == 'ready_for_review'"
                  decoration-danger="state == 'error'"
                  decoration-muted="state == 'reviewed'">
                <field name="name"/>
                <field name="customer_name"/>
                <field name="customer_email"/>
                <field name="create_date" string="Recibida"/>
                <field name="state" widget="badge"/>
                <field name="sale_order_id"/>
            </list>
        </field>
    </record>

    <record id="view_image_quote_request_form" model="ir.ui.view">
        <field name="name">local.ai.image.quote.request.form</field>
        <field name="model">local.ai.image.quote.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_create_quotation" type="object"
                            string="Crear cotización" class="btn-primary"
                            invisible="state not in ('ready_for_review', 'error')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,processing,ready_for_review,reviewed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Cliente">
                            <field name="customer_name"/>
                            <field name="customer_email"/>
                            <field name="customer_phone"/>
                        </group>
                        <group string="Origen">
                            <field name="ip_address" readonly="1"/>
                            <field name="sale_order_id" readonly="1"/>
                            <field name="error_message" invisible="not error_message"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Renglones detectados">
                            <p class="text-muted">
                                Solo los renglones marcados como "Confirmado" y con un
                                producto asignado se incluyen al crear la cotización.
                                Revisa cada uno contra el catálogo real antes de confirmar.
                            </p>
                            <field name="line_ids">
                                <list editable="bottom" decoration-muted="match_status == 'not_found'">
                                    <field name="text_detected" readonly="1"/>
                                    <field name="quantity_detected"/>
                                    <field name="product_id"/>
                                    <field name="match_status" widget="badge" readonly="1"/>
                                    <field name="match_confidence" readonly="1"/>
                                    <field name="confirmed" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                        <page string="Fotos originales">
                            <field name="image_ids">
                                <list>
                                    <field name="image_filename"/>
                                    <field name="extraction_status" widget="badge"/>
                                    <field name="error_message" invisible="not error_message"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_image_quote_request" model="ir.actions.act_window">
        <field name="name">Cotizaciones por imagen (IA)</field>
        <field name="res_model">local.ai.image.quote.request</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_image_quote_request"
              name="Cotizaciones por imagen (IA)"
              parent="sale.sale_menu_root"
              action="action_image_quote_request"
              sequence="60"/>

</odoo>

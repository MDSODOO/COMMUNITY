<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_qfm_sale_margin_line_rule_tree" model="ir.ui.view">
            <field name="name">qfm.sale.margin.line.rule.tree</field>
            <field name="model">qfm.sale.margin.line.rule</field>
            <field name="arch" type="xml">
                <list editable="bottom">
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="line_name"/>
                    <field name="margin_pct"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <record id="view_qfm_sale_margin_line_rule_form" model="ir.ui.view">
            <field name="name">qfm.sale.margin.line.rule.form</field>
            <field name="model">qfm.sale.margin.line.rule</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="line_name"/>
                            <field name="margin_pct"/>
                            <field name="active"/>
                            <field name="line_key" readonly="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_qfm_sale_margin_line_rule" model="ir.actions.act_window">
            <field name="name">Márgenes por línea</field>
            <field name="res_model">qfm.sale.margin.line.rule</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem
            id="menu_qfm_sale_margin_line_rule"
            name="Márgenes por línea"
            parent="sale.menu_sale_config"
            action="action_qfm_sale_margin_line_rule"
            sequence="95"
        />
    </data>
</odoo>

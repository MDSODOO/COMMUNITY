<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="product_template_form_view_margin" model="ir.ui.view">
            <field name="name">product.template.form.margin</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='purchase']" position="inside">
                    <group string="Historial de costos de compra" name="qfm_cost_history">
                        <field name="cost_history_ids" nolabel="1" readonly="1">
                            <list create="0" edit="0" delete="0" default_order="date desc">
                                <field name="date"/>
                                <field name="product_id"/>
                                <field name="cost"
                                       widget="monetary"
                                       options="{'currency_field': 'currency_id'}"/>
                                <field name="currency_id" column_invisible="True"/>
                                <field name="reference"/>
                            </list>
                        </field>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>

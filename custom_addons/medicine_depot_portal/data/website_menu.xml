<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!--
        Menus iniciales para el Website Builder.
        Se cargan una sola vez para que el editor del sitio pueda reordenarlos
        sin que una actualización del módulo los vuelva a sobrescribir.
    -->

    <delete model="website.menu"
            search="[('url', 'in', ['/', '/contactus', '/shop']), ('website_id', '=', ref('website.default_website'))]"/>

    <record id="menu_medicine_depot_home" model="website.menu">
        <field name="name">Inicio</field>
        <field name="url">/</field>
        <field name="website_id" ref="website.default_website"/>
        <field name="parent_id" search="[('url', '=', '/default-main-menu'), ('website_id', '=', ref('website.default_website'))]"/>
        <field name="sequence" type="int">5</field>
    </record>

    <record id="menu_medicine_depot_afiliacion" model="website.menu">
        <field name="name">Afiliación</field>
        <field name="url">/afiliacion</field>
        <field name="website_id" ref="website.default_website"/>
        <field name="parent_id" search="[('url', '=', '/default-main-menu'), ('website_id', '=', ref('website.default_website'))]"/>
        <field name="sequence" type="int">10</field>
    </record>

    <record id="menu_medicine_depot_medicd" model="website.menu">
        <field name="name">MedicD</field>
        <field name="url">https://medicinedepot.com.mx/medicd/</field>
        <field name="website_id" ref="website.default_website"/>
        <field name="parent_id" search="[('url', '=', '/default-main-menu'), ('website_id', '=', ref('website.default_website'))]"/>
        <field name="sequence" type="int">20</field>
    </record>

    <record id="menu_medicine_depot_sucursales" model="website.menu">
        <field name="name">Sucursales</field>
        <field name="url">/sucursales</field>
        <field name="website_id" ref="website.default_website"/>
        <field name="parent_id" search="[('url', '=', '/default-main-menu'), ('website_id', '=', ref('website.default_website'))]"/>
        <field name="sequence" type="int">30</field>
    </record>

    <record id="menu_medicine_depot_farmacovigilancia" model="website.menu">
        <field name="name">Farmacovigilancia</field>
        <field name="url">/farmacovigilancia</field>
        <field name="website_id" ref="website.default_website"/>
        <field name="parent_id" search="[('url', '=', '/default-main-menu'), ('website_id', '=', ref('website.default_website'))]"/>
        <field name="sequence" type="int">40</field>
    </record>

    <record id="menu_medicine_depot_blog" model="website.menu">
        <field name="name">Blog</field>
        <field name="url">/blog</field>
        <field name="website_id" ref="website.default_website"/>
        <field name="parent_id" search="[('url', '=', '/default-main-menu'), ('website_id', '=', ref('website.default_website'))]"/>
        <field name="sequence" type="int">45</field>
    </record>

    <record id="menu_medicine_depot_contacto" model="website.menu">
        <field name="name">Contacto</field>
        <field name="url">/contactus</field>
        <field name="website_id" ref="website.default_website"/>
        <field name="page_id" ref="medicine_depot_portal.contact_page"/>
        <field name="parent_id" search="[('url', '=', '/default-main-menu'), ('website_id', '=', ref('website.default_website'))]"/>
        <field name="sequence" type="int">50</field>
    </record>

</odoo>

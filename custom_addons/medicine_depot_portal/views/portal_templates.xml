<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Reemplaza el contenedor o_portal_my_home definido por
        portal.portal_my_home (Odoo 19) con un layout Bento-box.
        Apuntamos al div real con clase o_portal_my_home para evitar
        capturar nodos de texto/whitespace con node().
    -->
    <template id="md_portal_my_home_bento"
              inherit_id="portal.portal_my_home"
              name="Medicine Depot - Bento Home"
              priority="20">

        <!-- Desactiva el detalle lateral nativo de portal_layout.
             La información del usuario ya vive en .md_floating_nav. -->
        <xpath expr="//t[@t-set='my_details']" position="attributes">
            <attribute name="t-value">False</attribute>
        </xpath>

        <!-- Inyecta el Bento como hermano antes del contenedor estándar
             para preservar las anclas que purchase / sale / account /
             portal_picking_visibility heredan vía o_portal_docs y los
             divs portal_*_category. -->
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <div t-attf-class="md_bento_portal md_nav_c-#{user_id.partner_id.color or 0}">

                <!-- ════════════════════════════════════════════════════════════
                     PORTAL HOME COUNTERS DECOYS
                     ────────────────────────────────────────────────────────
                     La Interaction nativa @portal/interactions/
                     portal_home_counters (selector .o_portal_my_home)
                     ejecuta updateCounters() en willStart():

                       1) needed = [...this.el.querySelectorAll(
                              "[data-placeholder_count]"
                          )].map(el => el.dataset.placeholder_count);
                       2) RPC /my/counters con esos names.
                       3) Object.keys(response).forEach(name => {
                              const el = this.el.querySelector(
                                  `[data-placeholder_count='${name}']`);
                              el.textContent = response[name];
                              el.closest(".o_portal_index_card")
                                .classList.remove("d-none");
                          });
                       4) this.el.querySelector(".o_portal_doc_spinner")
                              .remove();

                     Reemplazar el layout estandar de portal.portal_my_home
                     deja sin DOM target a los nombres que el backend
                     devuelve via _get_my_counters(), causando:
                       TypeError: null is not an object
                       (evaluating documentsCounterEl.textContent=...)

                     Inyectamos decoys ocultos con los counter names que los
                     modulos en depends de este addon registran. Cada
                     decoy vive en su .o_portal_index_card (para que el
                     closest() del JS no caiga a null) y mantiene
                     .d-none para invisibilizar el wrapper. Si el backend
                     devuelve un name no listado aqui, el patch JS de
                     portal_home_counters_patch.js cubre el caso con
                     guards defensivos.

                     Counter names esperados:
                       quotation   (sale_management)
                       order       (sale_management)
                       invoice     (account)
                       picking     (stock / portal_picking_visibility)
                ═════════════════════════════════════════════════════════ -->
                <div class="md_portal_counter_decoys d-none" aria-hidden="true">
                    <div class="o_portal_index_card d-none">
                        <span data-placeholder_count="quotation">0</span>
                    </div>
                    <div class="o_portal_index_card d-none">
                        <span data-placeholder_count="order">0</span>
                    </div>
                    <div class="o_portal_index_card d-none">
                        <span data-placeholder_count="invoice">0</span>
                    </div>
                    <div class="o_portal_index_card d-none">
                        <span data-placeholder_count="picking">0</span>
                    </div>
                    <div class="o_portal_doc_spinner d-none"/>
                </div>

                <!-- ════════════════════════════════════════════════════════════
                     COLIBRI INTERACTIONS DECOY BUNDLE
                     ────────────────────────────────────────────────────────
                     Bundle hidden de decoys para satisfacer las
                     public.interactions de Odoo 19 (website_sale,
                     website_sale_wishlist) cuyo start() itera selectores
                     comunes y hace textContent = ... sin null-check.
                     Nuestro Bento reemplaza el header nativo de /my,
                     dejando esos selectores sin DOM target → TypeError.
                     Mantenemos los decoys aqui para trazabilidad y para
                     que sirvan a cualquier interaction que arranque
                     mientras el usuario navega el portal.

                     Selectores cubiertos:
                       .my_cart_quantity        → WebsiteSaleCart (badge carrito)
                       .o_wsale_my_cart         → wrapper link carrito
                       .o_wsale_my_cart_quantity→ variante prefixed del badge
                       .cart_quantity           → variante legacy del badge
                       .o_wsale_my_wish         → wrapper link wishlist
                       .my_wish_quantity        → badge numerico wishlist
                       .o_comparelist_counter   → badge comparador

                     Los decoys de .o_portal_doc_name y .o_portal_doc_count
                     viven en o_portal_docs. El respaldo consolidado de
                     carrito, wishlist, comparador y portal tambien se
                     inyecta globalmente en website.layout.
                ═════════════════════════════════════════════════════════ -->
                <div class="md_colibri_decoys d-none" aria-hidden="true">
                    <a href="/shop/cart" class="o_wsale_my_cart">
                        <sup class="my_cart_quantity badge">0</sup>
                        <sup class="o_wsale_my_cart_quantity badge">0</sup>
                        <span class="cart_quantity">0</span>
                    </a>
                    <a href="/shop/wishlist" class="o_wsale_my_wish">
                        <sup class="my_wish_quantity badge">0</sup>
                    </a>
                </div>

                <!-- ── Floating pill navbar (decoupled del sidebar nativo) ── -->
                <nav class="md_floating_nav" t-if="user_id">
                    <div class="md_nav_brand">
                        <span class="md_nav_avatar"
                              t-esc="(user_id.partner_id.name or '?')[:1].upper()"/>
                        <div class="md_nav_id">
                            <strong class="md_nav_name"
                                    t-esc="user_id.partner_id.name or 'Mi Portal'"/>
                            <small class="md_nav_email"
                                   t-if="user_id.partner_id.email"
                                   t-esc="user_id.partner_id.email"/>
                        </div>
                    </div>
                    <div class="md_nav_actions">
                        <a href="/shop" class="md_nav_pill md_nav_pill--active"
                           title="Visitar tienda">
                            <i class="fa fa-shopping-cart" aria-hidden="true"/>
                            <span>Visitar Tienda</span>
                        </a>
                        <a href="/my/orders" class="md_nav_pill" title="Mis órdenes">
                            <i class="fa fa-shopping-bag" aria-hidden="true"/>
                        </a>
                        <a href="/my/invoices" class="md_nav_pill" title="Mis facturas">
                            <i class="fa fa-file-text-o" aria-hidden="true"/>
                        </a>
                        <a href="/my/account" class="md_nav_pill" title="Mi perfil">
                            <i class="fa fa-user" aria-hidden="true"/>
                        </a>
                    </div>
                </nav>

                <div id="md_portal_extensions_hook" class="d-flex flex-column gap-3"/>

                <!-- ── Cards grid (1 hero rompe simetría) ─────────────────────
                     Orden visual (UX 2026-05-10, rev2):
                       1. Favoritos (HERO)
                       2. Mi cuenta
                       3. Sus órdenes               ← swap con Cotizaciones
                       4. Mis Pedidos (span 2)
                       5. Entregas
                       6. Cotizaciones              ← swap con Sus órdenes
                       7. Facturas
                       8. Direcciones
                      9. Conexión y seguridad
                     10. Documentos
                -->
                <t t-if="has_missing_docs">
                    <div class="alert alert-warning d-flex align-items-center md_aff_docs_alert" role="alert">
                        <i class="fa fa-exclamation-triangle me-2" aria-hidden="true"/>
                        <div class="flex-grow-1">
                            Estimado cliente, aún tiene documentos oficiales pendientes de cargar.
                            Por favor actualice su expediente.
                        </div>
                        <a t-att-href="affiliation_upload_url"
                           class="btn btn-sm btn-outline-dark ms-3">
                            Actualizar expediente
                        </a>
                    </div>
                </t>
                <section class="md_cards_grid">

                    <!-- HERO: Favoritos -->
                    <div class="md_data_card md_data_card--hero md_data_card--list md_data_card--favorites">
                        <div class="md_card_head">
                            <i class="fa fa-heart-o" aria-hidden="true"/>
                            <span>Favoritos</span>
                        </div>
                        <ul class="md_fav_list md_fav_list--hero">
                            <t t-foreach="favorite_products[:6]" t-as="fav">
                                <li class="md_fav_item">
                                    <a t-att-href="'/shop/product/%s' % fav['product'].id"
                                       class="md_fav_link">
                                        <span class="md_fav_name"
                                              t-esc="fav['product'].name"/>
                                        <span class="md_fav_chip"
                                              t-esc="fav['a_la_mano_label']"/>
                                    </a>
                                </li>
                            </t>
                            <li t-if="not favorite_products" class="md_card_dim">
                                Aún no hay productos recurrentes.
                            </li>
                        </ul>
                    </div>

                    <!-- Mi cuenta -->
                    <a href="/my/account" class="md_data_card md_data_card--account">
                        <div class="md_card_head">
                            <i class="fa fa-id-card-o" aria-hidden="true"/>
                            <span>Mi cuenta</span>
                        </div>
                        <p class="md_card_meta md_card_meta--solo">
                            Editar dirección, contacto y preferencias.
                        </p>
                    </a>

                    <!-- Sus órdenes (sube al slot de Cotizaciones) -->
                    <a t-att-href="active_order and active_order.get_portal_url() or '/my/orders'"
                       class="md_data_card md_data_card--orders">
                        <div class="md_card_head">
                            <i class="fa fa-shopping-bag" aria-hidden="true"/>
                            <span>Sus órdenes</span>
                        </div>
                        <div class="md_card_kpi">
                            <strong t-esc="orders_count or 0"/>
                            <small>confirmadas</small>
                        </div>
                        <p class="md_card_meta" t-if="last_order">
                            Última:
                            <span t-field="last_order.name"/>
                            ·
                            <span t-field="last_order.date_order"
                                  t-options='{"widget": "date"}'/>
                        </p>
                        <p class="md_card_meta" t-else="">
                            Aún no hay actividad.
                        </p>
                    </a>

                    <!-- Opción nativa: Mis Pedidos (span 2) -->
                    <a href="/my/pickings" class="md_data_card md_data_card--native md_data_card--native-pickings">
                        <div class="md_card_head">
                            <i class="fa fa-inbox" aria-hidden="true"/>
                            <span>Mis Pedidos</span>
                        </div>
                        <p class="md_card_meta md_card_meta--solo">
                            Consulta pedidos para recolección y entregas.
                        </p>
                    </a>

                    <!-- Entregas en curso -->
                    <a href="/my/pickings" class="md_data_card md_data_card--picking">
                        <div class="md_card_head">
                            <i class="fa fa-truck" aria-hidden="true"/>
                            <span>Entregas</span>
                        </div>
                        <div class="md_card_kpi">
                            <strong t-esc="pickings_count or 0"/>
                            <small>en curso</small>
                        </div>
                    </a>

                    <!-- Cotizaciones (baja al slot de Sus órdenes) -->
                    <a href="/my/quotes" class="md_data_card md_data_card--quote">
                        <div class="md_card_head">
                            <i class="fa fa-file-o" aria-hidden="true"/>
                            <span>Cotizaciones</span>
                        </div>
                        <div class="md_card_kpi">
                            <strong t-esc="quotes_count or 0"/>
                            <small>abiertas</small>
                        </div>
                    </a>

                    <!-- Facturas pendientes (toma la posición de Mi cuenta) -->
                    <a href="/my/invoices" class="md_data_card md_data_card--invoice">
                        <div class="md_card_head">
                            <i class="fa fa-file-text-o" aria-hidden="true"/>
                            <span>Facturas</span>
                        </div>
                        <div class="md_card_kpi">
                            <strong t-esc="pending_invoices_count or 0"/>
                            <small>pendientes</small>
                        </div>
                        <p class="md_card_meta" t-if="pending_invoices_count">
                            Saldo:
                            <t t-esc="'$%.2f' % (pending_invoices_total or 0.0)"/>
                        </p>
                        <p class="md_card_meta md_card_meta--ok" t-else="">
                            Todo al corriente.
                        </p>
                    </a>

                    <!-- Opción nativa: Direcciones -->
                    <a href="/my/account" class="md_data_card md_data_card--native md_data_card--native-addresses">
                        <div class="md_card_head">
                            <i class="fa fa-map-marker" aria-hidden="true"/>
                            <span>Direcciones</span>
                        </div>
                        <p class="md_card_meta md_card_meta--solo">
                            Actualiza direcciones y datos de contacto.
                        </p>
                    </a>

                    <!-- Opción nativa: Conexión y seguridad -->
                    <a href="/my/security" class="md_data_card md_data_card--native md_data_card--native-security">
                        <div class="md_card_head">
                            <i class="fa fa-lock" aria-hidden="true"/>
                            <span>Conexión y seguridad</span>
                        </div>
                        <p class="md_card_meta md_card_meta--solo">
                            Gestiona contraseña y dispositivos conectados.
                        </p>
                    </a>

                    <!-- Opción nativa: Documentos
                         Incluye anchor o_portal_docs_counter requerido por
                         el JS nativo de Odoo 19 (portal/documents counters).
                         Sin este elemento el bundle web.assets_frontend_lazy
                         lanza `TypeError: null is not an object
                         (evaluating 'documentsCounterEl.textContent')`. -->
                    <a href="/odoo/documents_portal" class="md_data_card md_data_card--native md_data_card--native-documents">
                        <div class="md_card_head">
                            <i class="fa fa-folder-open-o" aria-hidden="true"/>
                            <span>Documentos</span>
                            <span class="o_portal_docs_counter badge rounded-pill d-none"
                                  data-count="0"
                                  aria-hidden="true">0</span>
                        </div>
                        <p class="md_card_meta md_card_meta--solo">
                            Revisa archivos y documentación del portal.
                        </p>
                    </a>

                </section>
            </div>
        </xpath>

        <!-- Oculta visualmente el contenedor estándar pero lo conserva
             en el DOM para que toda la cadena de herencia siga resolviendo. -->
        <xpath expr="//div[hasclass('o_portal_docs')]" position="attributes">
            <attribute name="class" add="d-none" separator=" "/>
            <attribute name="aria-hidden">true</attribute>
        </xpath>

        <!-- Etiqueta el row padre que aloja el Bento. La SCSS conserva
             este wrapper como única superficie visible del dashboard. -->
        <xpath expr="//div[hasclass('o_portal_docs')]/.." position="attributes">
            <attribute name="class" add="md_bento_row portal-dashboard-active" separator=" "/>
        </xpath>

    </template>

    <!-- Colibri / website_sale ejecuta inicializadores que escriben
         textContent en contadores nativos del header. Este bloque
         global mantiene esos selectores en el DOM cuando nuestro
         layout activo reemplaza el header nativo. -->
    <template
        id="website_layout_wishlist_colibri_decoy"
        inherit_id="website.layout"
        name="Medicine Depot Colibri Counter Decoys"
        priority="210"
    >
        <xpath expr="//body" position="inside">
            <div class="md_colibri_decoys colibri-decoys d-none" aria-hidden="true">
                <ul class="list-unstyled m-0 p-0">
                    <li class="o_wsale_my_cart d-none">
                        <a href="/shop/cart" tabindex="-1">
                            <sup class="my_cart_quantity o_animate_blink badge bg-primary">0</sup>
                            <sup class="o_wsale_my_cart_quantity badge bg-primary">0</sup>
                            <span class="cart_quantity">0</span>
                        </a>
                    </li>
                    <li class="o_wsale_my_wish d-none">
                        <a href="/shop/wishlist" tabindex="-1">
                            <sup class="my_wish_quantity o_animate_blink badge bg-primary">0</sup>
                            <sup class="o_wsale_my_wish_quantity badge bg-primary">0</sup>
                            <span class="wish_quantity">0</span>
                        </a>
                    </li>
                    <li class="o_wsale_comparelist d-none">
                        <a href="/shop/compare" tabindex="-1">
                            <sup class="o_comparelist_counter o_animate_blink badge bg-primary">0</sup>
                            <sup class="o_comparelist_quantity badge bg-primary">0</sup>
                            <sup class="o_wsale_comparelist_count badge bg-primary">0</sup>
                            <span class="comparelist_quantity">0</span>
                        </a>
                    </li>
                </ul>
                <span class="o_portal_doc_name d-none"/>
                <span class="o_portal_doc_count d-none">0</span>
                <span class="o_portal_docs_counter d-none" data-count="0">0</span>
            </div>
        </xpath>
    </template>

    <template
        id="md_portal_my_details_medical_record"
        inherit_id="portal.portal_my_details"
        name="Medicine Depot - My Account Medical Record"
        priority="210"
    >
        <xpath expr="//form" position="replace">
            <!--
                IMPORTANTE — CustomerAddress Interaction (Odoo 19)
                ════════════════════════════════════════════════════
                La interacción nativa `address.js` arranca con el selector
                `.o_customer_address_fill`. En su setup() hace:

                  this.addressForm = this.el.querySelector('form.address_autoformat');
                  this.addressType = this.addressForm['address_type'].value;
                  this.countryCode = this.addressForm.dataset.companyCountryCode;
                  this.requiredFields = this.addressForm.required_fields.value.split(',');

                Si cualquiera de esos nodos falta → TypeError: null is not an object.

                Solución: envolver el <form> en .o_customer_address_fill y añadir:
                  · clase `address_autoformat` al <form>
                  · input[name="address_type"] oculto con valor "contact"
                  · input[name="required_fields"] oculto con campos requeridos
                  · data-company-country-code en el <form>
            -->
            <div class="o_customer_address_fill">
            <form action="/my/account" method="post" enctype="multipart/form-data"
                  class="address_autoformat"
                  t-att-data-company-country-code="request.env.company.country_id.code or ''">

                <!-- Tokens de sesión y redirección -->
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <input type="hidden" name="redirect" t-att-value="redirect"/>

                <!--
                    address_type: valor "contact" para la cuenta principal del portal.
                    El JS de Odoo 19 (CustomerAddress.setup) lee este campo para saber
                    qué tipo de dirección está editando y ajustar los campos requeridos
                    en la llamada RPC /my/address/country_info/{country_id}.
                -->
                <input type="hidden" name="address_type" value="contact"/>

                <!--
                    required_fields: lista separada por comas de los campos obligatorios
                    que el JS marcará visualmente como requeridos al cargar el form.
                    Valores estándar para /my/account: name, email.
                    El controlador Python (_prepare_address_form_values) puede añadir
                    más campos según el país; aquí definimos el mínimo seguro.
                -->
                <input type="hidden" name="required_fields" t-att-value="','.join(required_fields) if required_fields else 'name,email'"/>

                <div t-if="missing_docs" class="alert alert-warning d-flex align-items-start gap-2 mb-4" role="alert">
                    <i class="fa fa-exclamation-triangle mt-1" aria-hidden="true"/>
                    <span>
                        Atención: Tu expediente está incompleto. Por favor, adjunta los documentos oficiales
                        requeridos para mantener tu cuenta activa.
                    </span>
                </div>

                <div class="row o_portal_details g-4">
                    <div class="col-lg-6 col-md-12">
                        <!-- CARD 1: DATOS PERSONALES -->
                        <div class="bento-card">
                            <div class="bento-card-title">
                                <i class="fa fa-user" aria-hidden="true"/>
                                <span>Datos Personales</span>
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="name">Nombre / Razón Social</label>
                                <input type="text" name="name" t-att-value="name or request.env.user.partner_id.name" class="form-control" required="required"/>
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="email">Correo Electrónico</label>
                                <input type="email" name="email" t-att-value="email or request.env.user.partner_id.email" class="form-control" required="required"/>
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="phone">Teléfono</label>
                                <input type="tel" name="phone" t-att-value="phone or request.env.user.partner_id.phone" class="form-control" required="required"/>
                            </div>
                        </div>

                        <!-- CARD 2: DIRECCIÓN Y ENVÍO -->
                        <div class="bento-card">
                            <div class="bento-card-title">
                                <i class="fa fa-map-marker" aria-hidden="true"/>
                                <span>Dirección y Envío</span>
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="street">Calle y Número</label>
                                <input type="text" name="street" t-att-value="street or request.env.user.partner_id.street" class="form-control"/>
                            </div>
                            <div class="row g-2">
                                <div class="col-md-8 mb-3">
                                    <label class="form-label" for="city">Ciudad</label>
                                    <input type="text" name="city" t-att-value="city or request.env.user.partner_id.city" class="form-control"/>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label class="form-label" for="zip">Código Postal</label>
                                    <input type="text" name="zip" t-att-value="zip or request.env.user.partner_id.zip" class="form-control"/>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="country_id">País</label>
                                <select name="country_id" class="form-select">
                                    <option value="">Selecciona un país...</option>
                                    <t t-foreach="countries or []" t-as="c">
                                        <option t-att-value="c.id" t-att-selected="c.id == (country_id or request.env.user.partner_id.country_id.id or country.id)">
                                            <t t-esc="c.name"/>
                                        </option>
                                    </t>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="state_id">Estado</label>
                                <select name="state_id" class="form-select">
                                    <option value="">Selecciona un estado...</option>
                                    <t t-foreach="states or []" t-as="s">
                                        <option t-att-value="s.id" t-att-selected="s.id == (state_id or request.env.user.partner_id.state_id.id)">
                                            <t t-esc="s.name"/>
                                        </option>
                                    </t>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-6 col-md-12">
                        <!-- CARD 3: INFORMACIÓN FISCAL Y COMERCIAL -->
                        <div class="bento-card">
                            <div class="bento-card-title">
                                <i class="fa fa-id-card-o" aria-hidden="true"/>
                                <span>Información Comercial y Fiscal</span>
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="company_name">Nombre de la Empresa</label>
                                <input type="text" name="company_name" t-att-value="company_name or request.env.user.partner_id.company_name" class="form-control"/>
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="vat">RFC (Identificación Fiscal)</label>
                                <input type="text" name="vat" t-att-value="vat or request.env.user.partner_id.vat" class="form-control"/>
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="x_studio_contact_type">Tipo de contacto</label>
                                <select id="x_studio_contact_type" name="x_studio_contact_type" class="form-select">
                                    <option value="">Selecciona una opción</option>
                                    <t t-foreach="contact_type_options" t-as="opt">
                                        <option t-att-value="opt[0]"
                                                t-att-selected="'selected' if request.env.user.partner_id and request.env.user.partner_id.x_studio_contact_type == opt[0] else False">
                                            <t t-esc="opt[1]"/>
                                        </option>
                                    </t>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="x_studio_branch_office">Sucursal</label>
                                <select id="x_studio_branch_office" name="x_studio_branch_office" class="form-select">
                                    <option value="">Selecciona una opción</option>
                                    <t t-foreach="branch_office_options" t-as="opt">
                                        <option t-att-value="opt[0]"
                                                t-att-selected="'selected' if selected_branch_office == opt[0] else False">
                                            <t t-esc="opt[1]"/>
                                        </option>
                                    </t>
                                </select>
                            </div>
                            <div class="mb-3">
                                <label class="form-label" for="x_studio_person_type">Tipo de persona</label>
                                <select id="x_studio_person_type" name="x_studio_person_type" class="form-select">
                                    <option value="">Selecciona una opción</option>
                                    <t t-foreach="person_type_options" t-as="opt">
                                        <option t-att-value="opt[0]"
                                                t-att-selected="'selected' if request.env.user.partner_id and request.env.user.partner_id.x_studio_person_type == opt[0] else False">
                                            <t t-esc="opt[1]"/>
                                        </option>
                                    </t>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="col-12">
                        <!-- CARD 4: EXPEDIENTE COFEPRIS -->
                        <div class="bento-card">
                            <div class="bento-card-title">
                                <i class="fa fa-certificate" aria-hidden="true"/>
                                <span>COFEPRIS (Expediente)</span>
                            </div>
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label" for="x_studio_operation_notice">Aviso de Funcionamiento</label>
                                    <input id="x_studio_operation_notice" type="file" name="x_studio_operation_notice" class="form-control" accept=".pdf,.jpg,.jpeg,.png"/>
                                    <small class="text-muted" t-if="request.env.user.partner_id and request.env.user.partner_id.x_studio_operation_notice">Documento cargado actualmente.</small>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label" for="x_studio_sanitary_license">Licencia Sanitaria</label>
                                    <input id="x_studio_sanitary_license" type="file" name="x_studio_sanitary_license" class="form-control" accept=".pdf,.jpg,.jpeg,.png"/>
                                    <small class="text-muted" t-if="request.env.user.partner_id and request.env.user.partner_id.x_studio_sanitary_license">Documento cargado actualmente.</small>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label" for="x_studio_sanitary_responsible_notice">Aviso de Responsable Sanitario</label>
                                    <input id="x_studio_sanitary_responsible_notice" type="file" name="x_studio_sanitary_responsible_notice" class="form-control" accept=".pdf,.jpg,.jpeg,.png"/>
                                    <small class="text-muted" t-if="request.env.user.partner_id and request.env.user.partner_id.x_studio_sanitary_responsible_notice">Documento cargado actualmente.</small>
                                </div>
                            </div>
                        </div>

                        <!-- CARD 5: DOCUMENTOS LEGALES -->
                        <div class="bento-card">
                            <div class="bento-card-title">
                                <i class="fa fa-file-pdf-o" aria-hidden="true"/>
                                <span>Documentos Legales</span>
                            </div>
                            <div class="row g-3">
                                <div class="col-md-3 col-sm-6">
                                    <label class="form-label" for="x_studio_ine">INE</label>
                                    <input id="x_studio_ine" type="file" name="x_studio_ine" class="form-control" accept=".pdf,.jpg,.jpeg,.png"/>
                                    <small class="text-muted" t-if="request.env.user.partner_id and request.env.user.partner_id.x_studio_ine">Documento cargado actualmente.</small>
                                </div>
                                <div class="col-md-3 col-sm-6">
                                    <label class="form-label" for="x_studio_proof_of_address">Comprobante de domicilio</label>
                                    <input id="x_studio_proof_of_address" type="file" name="x_studio_proof_of_address" class="form-control" accept=".pdf,.jpg,.jpeg,.png"/>
                                    <small class="text-muted" t-if="request.env.user.partner_id and request.env.user.partner_id.x_studio_proof_of_address">Documento cargado actualmente.</small>
                                </div>
                                <div class="col-md-3 col-sm-6">
                                    <label class="form-label" for="x_studio_professional_license">Cédula profesional</label>
                                    <input id="x_studio_professional_license" type="file" name="x_studio_professional_license" class="form-control" accept=".pdf,.jpg,.jpeg,.png"/>
                                    <small class="text-muted" t-if="request.env.user.partner_id and request.env.user.partner_id.x_studio_professional_license">Documento cargado actualmente.</small>
                                </div>
                                <div class="col-md-3 col-sm-6">
                                    <label class="form-label" for="x_studio_tax_status_certificate">Constancia de situación fiscal</label>
                                    <input id="x_studio_tax_status_certificate" type="file" name="x_studio_tax_status_certificate" class="form-control" accept=".pdf,.jpg,.jpeg,.png"/>
                                    <small class="text-muted" t-if="request.env.user.partner_id and request.env.user.partner_id.x_studio_tax_status_certificate">Documento cargado actualmente.</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="clearfix mt-4">
                    <button type="submit" class="btn btn-primary float-end mb32">
                        Confirmar
                        <span class="fa fa-long-arrow-right"/>
                    </button>
                </div>
            </form>
            </div><!-- /.o_customer_address_fill -->
        </xpath>
    </template>

    <template id="md_portal_my_security_bento"
              inherit_id="portal.portal_my_security"
              name="Medicine Depot - My Security Bento"
              priority="210">
        <xpath expr="//form[@action='/my/security']" position="replace">
            <div class="bento-card md-password-change-card">
                <div class="bento-card-title">
                    <i class="fa fa-lock" aria-hidden="true"/>
                    <span>Cambiar Contraseña</span>
                </div>
                <form action="/my/security" method="post" class="oe_reset_password_form p-0 bg-transparent border-0 shadow-none">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <div class="mb-3">
                        <label class="form-label" for="current">Contraseña Actual</label>
                        <input type="password" name="old" id="current" class="form-control" required="required" autocomplete="current-password"/>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="new">Nueva Contraseña</label>
                        <input type="password" name="new1" id="new" class="form-control" required="required" autocomplete="new-password"/>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="new2">Confirmar Nueva Contraseña</label>
                        <input type="password" name="new2" id="new2" class="form-control" required="required" autocomplete="new-password"/>
                    </div>
                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <button type="submit" class="btn btn-primary rounded-pill px-4">Guardar Cambios</button>
                    </div>
                </form>
            </div>
        </xpath>
    </template>


</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="ir.module.category" id="module_category_custom_access_sales">
        <field name="name">Permisos Ventas</field>
        <field name="description">Control de accesos en ventas</field>
        <field name="sequence">30</field>
    </record>

    <record model="res.groups.privilege" id="privilege_sale_price">
        <field name="name">Editar precio venta</field>
        <field name="category_id" ref="module_category_custom_access_sales"/>
    </record>

    <record model="res.groups.privilege" id="privilege_sale_tax">
        <field name="name">Editar impuestos venta</field>
        <field name="category_id" ref="module_category_custom_access_sales"/>
    </record>

    <record id="group_sale_edit_price" model="res.groups">
        <field name="name">Si</field>
        <field name="comment">Permite editar precio unitario</field>
        <field name="privilege_id" ref="privilege_sale_price"/>
    </record>

    <record id="group_sale_edit_tax" model="res.groups">
        <field name="name">Si</field>
        <field name="comment">Permite editar impuestos</field>
        <field name="privilege_id" ref="privilege_sale_tax"/>
    </record>


    <record model="ir.module.category" id="module_category_custom_access_account">
        <field name="name">Permisos Facturas</field>
        <field name="description">Control de accesos en facturación</field>
        <field name="sequence">31</field>
    </record>


    <record model="res.groups.privilege" id="privilege_account_payment">
        <field name="name">Botón pagar factura</field>
        <field name="category_id" ref="module_category_custom_access_account"/>
    </record>

    <record model="res.groups.privilege" id="privilege_account_draft">
        <field name="name">Restablecer factura a borrador</field>
        <field name="category_id" ref="module_category_custom_access_account"/>
    </record>

    <record id="group_account_payment" model="res.groups">
        <field name="name">Si</field>
        <field name="comment">Permite registrar pagos</field>
        <field name="privilege_id" ref="privilege_account_payment"/>
    </record>

    <record id="group_account_draft" model="res.groups">
        <field name="name">Si</field>
        <field name="comment">Permite regresar a borrador</field>
        <field name="privilege_id" ref="privilege_account_draft"/>
    </record>

</odoo>
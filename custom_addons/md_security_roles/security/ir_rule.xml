<odoo>
    <data noupdate="1">

        <!--
            Los Operadores de Almacén (Handheld) solo pueden visualizar lotes cuya
            cantidad "A la mano" sea mayor a cero, evitando que las consultas de
            campo muestren lotes ya agotados.
            Warehouse Handheld Operators can only view lots whose "A la mano"
            (On Hand) quantity is greater than zero, preventing depleted lots
            from showing up in field queries.
        -->
        <record id="rule_stock_lot_qty_a_la_mano_handheld" model="ir.rule">
            <field name="name">Regla Lotes Mayor a Cero - Handheld</field>
            <field name="model_id" ref="stock.model_stock_lot"/>
            <field name="groups" eval="[(4, ref('group_md_almacen'))]"/>
            <field name="domain_force">[('product_qty', '&gt;', 0)]</field>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

    </data>
</odoo>

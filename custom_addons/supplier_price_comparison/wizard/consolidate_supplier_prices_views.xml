<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_consolidate_supplier_prices_form" model="ir.ui.view">
        <field name="name">consolidate.supplier.prices.wizard.form</field>
        <field name="model">consolidate.supplier.prices.wizard</field>
        <field name="arch" type="xml">
            <form string="Consolidar Precios (Excel)" create="0" edit="1">
                <sheet>
                    <div class="md-pc-consolidator-shell">
                        <div class="md-pc-consolidator-hero">
                            <div class="hero-kicker">Workflow Principal</div>
                            <h2>Consolidar Precios (Excel)</h2>
                            <p>
                                Carga el archivo base y los tres catálogos de proveedor para
                                generar un solo archivo consolidado, con formato y reporte.
                            </p>
                        </div>

                        <div class="md-pc-consolidator-grid">
                            <div class="md-pc-consolidator-card">
                                <div class="card-title">1) Archivo Base</div>
                                <group>
                                    <field name="base_file" filename="base_filename"/>
                                    <field name="base_filename" invisible="1"/>
                                </group>
                            </div>

                            <div class="md-pc-consolidator-card">
                                <div class="card-title">2) Levic / Quifamesa</div>
                                <group>
                                    <field name="levic_file" filename="levic_filename"/>
                                    <field name="levic_filename" invisible="1"/>
                                </group>
                            </div>

                            <div class="md-pc-consolidator-card">
                                <div class="card-title">3) Farmater / Elite HS</div>
                                <group>
                                    <field name="farmater_file" filename="farmater_filename"/>
                                    <field name="farmater_filename" invisible="1"/>
                                </group>
                            </div>

                            <div class="md-pc-consolidator-card">
                                <div class="card-title">4) Brudifarma / A la mano BF</div>
                                <group>
                                    <field name="brudifarma_file" filename="brudifarma_filename"/>
                                    <field name="brudifarma_filename" invisible="1"/>
                                </group>
                            </div>
                        </div>
                    </div>

                    <group string="Resultados" invisible="not output_file">
                        <div class="md-pc-kpi-strip">
                            <div class="md-pc-kpi-card kpi-best">
                                <div class="kpi-label">Procesados</div>
                                <div class="kpi-value">
                                    <field name="total_processed" nolabel="1"/>
                                </div>
                            </div>
                            <div class="md-pc-kpi-card kpi-supplier">
                                <div class="kpi-label">Levic</div>
                                <div class="kpi-value">
                                    <field name="levic_matches" nolabel="1"/>
                                </div>
                            </div>
                            <div class="md-pc-kpi-card kpi-cost">
                                <div class="kpi-label">Farmater</div>
                                <div class="kpi-value">
                                    <field name="farmater_matches" nolabel="1"/>
                                </div>
                            </div>
                            <div class="md-pc-kpi-card kpi-diff">
                                <div class="kpi-label">Brudifarma</div>
                                <div class="kpi-value">
                                    <field name="brudifarma_matches" nolabel="1"/>
                                </div>
                            </div>
                            <div class="md-pc-kpi-card">
                                <div class="kpi-label">Sin Precio</div>
                                <div class="kpi-value">
                                    <field name="without_matches" nolabel="1"/>
                                </div>
                            </div>
                        </div>
                    </group>

                    <group string="Archivo Consolidado" invisible="not output_file">
                        <group>
                            <field name="output_file" filename="output_filename"/>
                            <field name="output_filename" readonly="1"/>
                        </group>
                    </group>

                    <group string="Reporte" invisible="not report_message">
                        <field name="report_message" readonly="1" widget="text"
                               style="white-space: pre-wrap; font-family: monospace;"/>
                    </group>
                </sheet>

                <footer>
                    <button name="action_consolidate" type="object"
                            class="btn-primary" string="Consolidar Ahora"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_consolidate_supplier_prices" model="ir.actions.act_window">
        <field name="name">Consolidar Precios (Excel)</field>
        <field name="res_model">consolidate.supplier.prices.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
